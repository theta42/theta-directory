  // Delegated (not direct) since app.modal.open() rebuilds the modal body
  // from scratch every call -- a direct .on() bind here would silently stop
  // firing after the first Add/Edit.
  app.modal.on('input change', '#res-name, #res-kind', function() {
    const id = $('#res-id').val();
    if (!id && $('#res-name').val()) {
      const name = $('#res-name').val();
      const kind = $('#res-kind').val();
      let prefix = '';
      if (kind === 'service') prefix = 'app_';
      if (kind === 'host') prefix = 'host_';
      if (kind === 'site') prefix = 'site_';

      const slug = prefix + name.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');
      $('#res-slug').val(slug);
    }
  });

  // OAuth clients are services carrying one of these subtypes -- `kind: 'oauth'`
  // no longer exists (models/oauth_client.js). Kept as a list rather than a
  // single string because a SAML SP and an OIDC RP want the same client
  // credentials panel.
  var OAUTH_SUBTYPES = ['oauth', 'oidc-client', 'saml-sp'];
  function isOAuthSubtype(subType) {
    return OAUTH_SUBTYPES.indexOf(String(subType || '').toLowerCase()) !== -1;
