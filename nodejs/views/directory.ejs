  // Indexed by resource id only. There is no by-hostname index any more: the
  // agent binds to its theta-agent service in the graph, and a second index
  // keyed on a name is exactly the loose match that put one machine's
  // telemetry on another machine's row.
  function indexAgents(agents) {
    agentsByResource = {};
    agentsById = {};
    for (const a of agents || []) {
      agentsById[a.id] = a;
      if (a.resourceId) agentsByResource[a.resourceId] = a;
    }
  }

  // Resource timestamps are UNIX SECONDS (routes/api_directory_admin.js). This
  // used to hand the value straight to moment(), which reads a bare number as
  // MILLISECONDS -- so every resource in the directory claimed it was created
  // in January 1970.
  //
  // Tolerant of both: rows written before the switch are still milliseconds,
  // and a "seconds" value large enough to be a plausible ms timestamp is one.
  function fmtStamp(value) {
    const n = Number(value);
    if (!n || !isFinite(n)) return '';
    const ms = n < 1e11 ? n * 1000 : n;
    const m = moment(ms);
    return m.isValid() ? m.format('YYYY-MM-DD HH:mm') : '';
  }

  function esc(s) { return s == null ? '' : app.util.escapeHtml(String(s)); }
  function timeAgo(iso) { if (!iso) return ''; var m = moment(iso); return m.isValid() ? m.fromNow() : ''; }

  // The composite status the scheduler wrote (services/scheduler.js evaluates
  // the subtype's status_rules against telemetry + plugin state).
  //
  // `force` is for nodes we know SHOULD have a status -- a host, a service an
  // agent reports -- where a grey "not evaluated yet" dot is real information.
  // Everything else gets no dot at all rather than a grey one: a site or a
  // catalog entry with no rules defined is not unhealthy or unknown, it is
  // simply not a thing that has a status, and a row of grey dots that never
  // change teaches people to ignore the column.
  const STATUS_STYLE = {
    ok:       { color: '#198754', title: 'Healthy' },
    warning:  { color: '#ffc107', title: 'Warning' },
    critical: { color: '#dc3545', title: 'Critical' },
    error:    { color: '#dc3545', title: 'Critical' },
    unknown:  { color: '#adb5bd', title: 'Unknown' }
  };

  function attachCompositeStatus(n, force) {
    const md = n.metadata || {};
    const style = STATUS_STYLE[md.status];
    if (style) {
      n.hasStatusDot = true;
      n.statusColor = style.color;
      n.statusTitle = md.status_message || style.title;
      return;
    }

    // No status of its own: show the worst thing underneath it. A site has no
    // telemetry and no rules, so without this the top of the tree -- the row
    // you are looking at when everything is collapsed -- was the one row that
    // never said anything.
    const rolled = STATUS_STYLE[md.bubbled_status];
    if (rolled) {
      n.hasStatusDot = true;
      n.statusColor = rolled.color;
      n.isRolledStatus = true;
      n.statusTitle = md.bubbled_status_from
        ? rolled.title + ' — from ' + md.bubbled_status_from
        : rolled.title + ' — rolled up from below';
      return;
    }

    if (!force) { n.hasStatusDot = false; return; }
    n.hasStatusDot = true;
    n.statusColor = '#adb5bd';
    n.statusTitle = md.status_message || 'No status evaluated yet';
  }

  function attachAgentStatus(n) {
    n.isHost = true;
    // The agent is bound to a theta-agent service child under this host.
    let a = null;
    if (allEdges.length) {
      const childIds = allEdges.filter(e => e.parentId === n.id).map(e => e.childId);
      for (const cid of childIds) {
        const child = resourcesById[cid];
        if (child && child.kind === 'service' && child.metadata?.subType === 'theta-agent' && agentsByResource[cid]) {
          a = agentsByResource[cid];
          break;
        }
      }
    }
    // Deliberately no name/slug fallback. Matching an agent to a host because
    // their names look alike is the same loose matching that put one site's
    // telemetry on another site's resource; the edge is the binding, and if
    // the edge is missing the honest answer is "no agent".
    n.agent = a || null;
    if (resourcesById[n.id]) resourcesById[n.id].agent = a || null;
    attachCompositeStatus(n, true);
  }


