                  <tr>
                    <th class="small">Artifact</th>
                    <th class="small">Purpose</th>
                    <th class="small">Size</th>
                    <th class="small" style="width:40%">URL</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="agent-download-table"></tbody>
              </table>
              <div id="agent-download-status" class="small mb-2"></div>
              <p class="small text-muted mb-0">
                Versioned release artifacts (the installer name carries the version) and checksums are staged by
                <code>setup.sh</code> from the suite's pinned theta-agent release; anything not staged is shown
                greyed out — re-run <code>setup.sh</code> to stage it.
              </p>
