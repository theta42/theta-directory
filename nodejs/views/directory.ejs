  function renderSubtypeTemplatesTable() {
    const $list = $('#subtype-templates-list');
    if (!$list.length) return;
    $list.empty();
    const query = ($('#subtype-search-filter').val() || '').toLowerCase().trim();
    const kindFilter = $('#subtype-kind-filter').val();
    const catFilter = $('#subtype-cat-filter').val();

    // Populate category dropdown
    const categories = new Set();
    subtypeTemplates.forEach(t => { if (t.category) categories.add(t.category); });
    const $catSelect = $('#subtype-cat-filter');
    const existingVal = $catSelect.val();
    $catSelect.html('<option value="">All Categories</option>' + [...categories].sort().map(c => `<option value="${esc(c)}" ${c === existingVal ? 'selected' : ''}>${esc(c)}</option>`).join(''));

    const filtered = subtypeTemplates.filter(t => {
      if (kindFilter && t.target_kind !== kindFilter) return false;
      if (catFilter && t.category !== catFilter) return false;
      if (query) {
        const text = `${t.name} ${t.slug} ${t.description || ''} ${t.category || ''} ${t.target_kind || ''}`.toLowerCase();
        if (!text.includes(query)) return false;
      }
      return true;
    });

    if (filtered.length === 0) {
      $list.append('<tr><td colspan="7" class="text-center text-muted py-4"><i class="fa-solid fa-shapes text-black-50 fs-2 mb-2"></i><br>No subtype templates match the current filter.</td></tr>');
      return;
    }

    filtered.sort((a, b) => (a.name || a.slug).localeCompare(b.name || b.slug));

    filtered.forEach(t => {
      const iconCls = t.icon || 'fa-solid fa-shapes';
      const kindBadges = {
        site: 'bg-info text-dark',
        host: 'bg-success',
        service: 'bg-primary'
      };
      const kindBadge = `<span class="badge ${kindBadges[t.target_kind] || 'bg-secondary'}">${esc(t.target_kind || 'service')}</span>`;
      const catBadge = t.category ? `<span class="badge bg-light text-dark border">${esc(t.category)}</span>` : '<span class="text-muted small">—</span>';

      const caps = [];
      if (t.ssh_capable) caps.push('<span class="badge bg-dark text-light me-1" title="SSH Shell Capable"><i class="fa-solid fa-terminal me-1"></i>SSH</span>');
      if (t.inherits_host_access) caps.push('<span class="badge bg-light text-dark border me-1" title="Inherits Host Access"><i class="fa-solid fa-sitemap me-1"></i>Host Access</span>');
      const capsHtml = caps.length ? caps.join('') : '<span class="text-muted small">—</span>';

      const props = (t.schema && t.schema.properties) ? Object.keys(t.schema.properties) : [];
      const propsHtml = props.length
        ? `<span class="badge bg-secondary me-1" title="${esc(props.join(', '))}">${props.length} field(s)</span> <small class="text-muted font-monospace">${esc(props.slice(0, 3).join(', '))}${props.length > 3 ? '…' : ''}</small>`
        : '<span class="text-muted small">None</span>';

      const rules = Array.isArray(t.status_rules) ? t.status_rules : [];
      const rulesHtml = rules.length
        ? `<span class="badge bg-warning text-dark">${rules.length} rule(s)</span>`
        : '<span class="text-muted small">—</span>';

      const row = `
        <tr>
          <td>
            <div class="d-flex align-items-center">
              <span class="me-2 text-primary fs-5" style="width: 24px; text-align: center;"><i class="${esc(iconCls)}"></i></span>
              <div>
                <strong>${esc(t.name)}</strong>
                <span class="font-monospace text-muted small ms-1">(${esc(t.slug)})</span>
                ${t.description ? `<div class="text-muted small text-truncate" style="max-width: 320px;">${esc(t.description)}</div>` : ''}
              </div>
            </div>
          </td>
          <td>${kindBadge}</td>
          <td>${catBadge}</td>
          <td>${capsHtml}</td>
          <td>${propsHtml}</td>
          <td>${rulesHtml}</td>
          <td class="text-end pe-3">
            <button class="btn btn-sm btn-outline-primary me-1" onclick="openSubtypeModal('${esc(t.id)}')"><i class="fas fa-pen"></i> Edit</button>
            <button class="btn btn-sm btn-outline-danger" onclick="deleteSubtypeTemplate('${esc(t.id)}', '${esc(t.name || t.slug)}')"><i class="fas fa-trash"></i></button>
          </td>
        </tr>
      `;
      $list.append(row);
    });
  }

  function addSchemaPropertyRow(key = '', type = 'string', desc = '', required = false, enumVals = '') {
    const rowId = 'schema-prop-' + Math.random().toString(36).substring(2, 9);
    const html = `
      <tr id="${rowId}" class="schema-prop-row">
        <td><input type="text" class="form-control form-control-sm font-monospace prop-key" value="${esc(key)}" placeholder="e.g. targetPort"></td>
        <td>
          <select class="form-select form-select-sm prop-type" onchange="togglePropEnumInput('${rowId}')">
            <option value="string" ${type === 'string' ? 'selected' : ''}>string</option>
            <option value="number" ${type === 'number' ? 'selected' : ''}>number</option>
            <option value="boolean" ${type === 'boolean' ? 'selected' : ''}>boolean</option>
            <option value="array" ${type === 'array' ? 'selected' : ''}>array</option>
            <option value="enum" ${type === 'enum' ? 'selected' : ''}>enum</option>
          </select>
          <input type="text" class="form-control form-control-sm prop-enum mt-1" placeholder="val1, val2" value="${esc(enumVals)}" style="display: ${type === 'enum' ? 'block' : 'none'};">
        </td>
        <td><input type="text" class="form-control form-control-sm prop-desc" value="${esc(desc)}" placeholder="Field label / description"></td>
        <td class="text-center"><input type="checkbox" class="form-check-input prop-required" ${required ? 'checked' : ''}></td>
        <td class="text-center">
          <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeSchemaPropertyRow('${rowId}')"><i class="fa-solid fa-trash"></i></button>
        </td>
      </tr>
    `;
    $('#sub-schema-props-list').append(html);
  }

  function togglePropEnumInput(rowId) {
    const isEnum = $(`#${rowId} .prop-type`).val() === 'enum';
    $(`#${rowId} .prop-enum`).toggle(isEnum);
  }

  function collectSchemaFromBuilder() {
    const properties = {};
    const required = [];
    $('.schema-prop-row').each(function() {
      const key = $(this).find('.prop-key').val().trim();
      if (!key) return;
      const type = $(this).find('.prop-type').val();
      const desc = $(this).find('.prop-desc').val().trim();
      const isReq = $(this).find('.prop-required').is(':checked');
      const enumStr = $(this).find('.prop-enum').val().trim();

      const prop = { description: desc };
      if (type === 'enum') {
        prop.type = 'string';
        prop.enum = enumStr.split(',').map(x => x.trim()).filter(Boolean);
      } else {
        prop.type = type;
      }
      properties[key] = prop;
      if (isReq) required.push(key);
    });
    return {
      $schema: 'https://json-schema.org/draft/2020-12/schema',
      type: 'object',
      properties: properties,
      required: required
    };
  }

  var currentSchemaEditorMode = 'builder';
  function toggleSchemaEditorMode(mode) {
    currentSchemaEditorMode = mode;
    if (mode === 'raw') {
      const schemaObj = collectSchemaFromBuilder();
      $('#sub-tmpl-schema-json').val(JSON.stringify(schemaObj, null, 2));
      $('#sub-schema-builder-container').hide();
      $('#sub-schema-raw-container').show();
      $('#btn-schema-builder-mode').removeClass('btn-primary').addClass('btn-outline-primary');
      $('#btn-schema-raw-mode').removeClass('btn-outline-secondary').addClass('btn-secondary');
    } else {
      try {
        const raw = $('#sub-tmpl-schema-json').val().trim();
        const obj = raw ? JSON.parse(raw) : { properties: {} };
        populateSchemaBuilder(obj);
      } catch (err) {
        app.messages.toast('Invalid JSON Schema: ' + err.message, 'warning');
      }
      $('#sub-schema-raw-container').hide();
      $('#sub-schema-builder-container').show();
      $('#btn-schema-builder-mode').removeClass('btn-outline-primary').addClass('btn-primary');
      $('#btn-schema-raw-mode').removeClass('btn-secondary').addClass('btn-outline-secondary');
    }
  }

  function populateSchemaBuilder(schemaObj) {
    $('#sub-schema-props-list').empty();
    const props = (schemaObj && schemaObj.properties) || {};
    const reqList = (schemaObj && Array.isArray(schemaObj.required)) ? schemaObj.required : [];
    const entries = Object.entries(props);
    if (!entries.length) {
      // Empty
    } else {
      for (const [k, p] of entries) {
        const type = p.enum ? 'enum' : (p.type || 'string');
        const enumVals = p.enum ? p.enum.join(', ') : '';
        const desc = p.description || '';
        const isReq = reqList.includes(k);
        addSchemaPropertyRow(k, type, desc, isReq, enumVals);
      }
    }
  }

  function openSubtypeModal(id) {
    const tmpl = id ? subtypeTemplates.find(t => t.id === id) : null;
    const isEdit = !!tmpl;

    app.modal.open({
      title: isEdit ? 'Edit Subtype Template: ' + esc(tmpl.name) : 'New Subtype Template',
      size: 'lg',
      tabs: [
        { id: 'sub-general', label: 'General', bodyHtml: subtypeModalGeneralTab, active: true },
        { id: 'sub-capabilities', label: 'Capabilities & Placement', bodyHtml: subtypeModalCapabilitiesTab },
        { id: 'sub-schema', label: 'Schema Properties', bodyHtml: subtypeModalSchemaTab },
        { id: 'sub-status', label: 'Status Rules', bodyHtml: subtypeModalStatusTab }
      ],
      footer: {
        buttonsHtml: app.modal.footerButtons({ onSave: `saveSubtypeTemplate('${id || ''}')`, saveLabel: 'Save Template' })
      }
    });

    const categories = new Set();
    subtypeTemplates.forEach(t => { if (t.category) categories.add(t.category); });
    $('#sub-cat-datalist').html([...categories].sort().map(c => `<option value="${esc(c)}">`).join(''));

    if (isEdit) {
      $('#sub-tmpl-id').val(tmpl.id);
      $('#sub-tmpl-name').val(tmpl.name || '');
      $('#sub-tmpl-slug').val(tmpl.slug || '').prop('readonly', true);
      $('#sub-tmpl-target-kind').val(tmpl.target_kind || 'service');
      $('#sub-tmpl-category').val(tmpl.category || '');
      $('#sub-tmpl-description').val(tmpl.description || '');
      $('#sub-tmpl-icon').val(tmpl.icon || '');
      $('#sub-tmpl-icon-preview').attr('class', tmpl.icon || 'fa-solid fa-shapes');

      $('#sub-tmpl-ssh-capable').prop('checked', !!tmpl.ssh_capable);
      $('#sub-tmpl-inherits-access').prop('checked', !!tmpl.inherits_host_access);

      const parentTypes = tmpl.valid_parent_types || [];
      $('.parent-kind-check').each(function() {
        $(this).prop('checked', parentTypes.includes($(this).val()));
      });
      $('#sub-tmpl-parent-subtypes').val((tmpl.valid_parent_subtypes || []).join(', '));

      populateSchemaBuilder(tmpl.schema || { properties: {} });
      $('#sub-tmpl-schema-json').val(JSON.stringify(tmpl.schema || { properties: {} }, null, 2));

      $('#sub-tmpl-status-json').val(JSON.stringify(tmpl.status_rules || [], null, 2));
    } else {
      $('#sub-tmpl-id').val('');
      $('#sub-tmpl-name').val('');
      $('#sub-tmpl-slug').val('').prop('readonly', false);
      $('#sub-tmpl-target-kind').val('service');
      $('#sub-tmpl-category').val('');
      $('#sub-tmpl-description').val('');
      $('#sub-tmpl-icon').val('fa-solid fa-cube');
      $('#sub-tmpl-icon-preview').attr('class', 'fa-solid fa-cube');

      $('#sub-tmpl-ssh-capable').prop('checked', false);
      $('#sub-tmpl-inherits-access').prop('checked', false);
      $('.parent-kind-check').prop('checked', false);
      $('#sub-tmpl-parent-subtypes').val('');

      populateSchemaBuilder({ properties: {} });
      $('#sub-tmpl-schema-json').val('{\n  "properties": {}\n}');
      $('#sub-tmpl-status-json').val('[]');
    }
  }

  async function saveSubtypeTemplate(id) {
    const name = $('#sub-tmpl-name').val().trim();
    const slug = $('#sub-tmpl-slug').val().trim();
    const target_kind = $('#sub-tmpl-target-kind').val();
    const category = $('#sub-tmpl-category').val().trim() || null;
    const description = $('#sub-tmpl-description').val().trim() || null;
    const icon = $('#sub-tmpl-icon').val().trim() || null;

    if (!name || !slug) {
      app.messages.toast('Name and Slug are required.', 'warning');
      return;
    }

    const ssh_capable = $('#sub-tmpl-ssh-capable').is(':checked');
    const inherits_host_access = $('#sub-tmpl-inherits-access').is(':checked');

    const valid_parent_types = [];
    $('.parent-kind-check:checked').each(function() {
      valid_parent_types.push($(this).val());
    });

    const parentSubtypesRaw = $('#sub-tmpl-parent-subtypes').val().trim();
    const valid_parent_subtypes = parentSubtypesRaw ? parentSubtypesRaw.split(',').map(x => x.trim()).filter(Boolean) : [];

    let schema;
    if (currentSchemaEditorMode === 'raw') {
      try {
        const raw = $('#sub-tmpl-schema-json').val().trim();
        schema = raw ? JSON.parse(raw) : { properties: {} };
      } catch (err) {
        app.messages.toast('Invalid Schema JSON: ' + err.message, 'danger');
        return;
      }
    } else {
      schema = collectSchemaFromBuilder();
    }

    let status_rules;
    try {
      const rawRules = $('#sub-tmpl-status-json').val().trim();
      status_rules = rawRules ? JSON.parse(rawRules) : [];
      if (!Array.isArray(status_rules)) {
        app.messages.toast('Status rules must be a JSON array.', 'danger');
        return;
      }
    } catch (err) {
      app.messages.toast('Invalid Status Rules JSON: ' + err.message, 'danger');
      return;
    }

    const payload = {
      name,
      slug,
      target_kind,
      category,
      description,
      icon,
      ssh_capable,
      inherits_host_access,
      valid_parent_types,
      valid_parent_subtypes,
      schema,
      status_rules
    };

    try {
      if (id) {
        await app.api.put('subtype-templates/' + encodeURIComponent(id), payload);
        app.messages.toast('Subtype template updated successfully!', 'success');
      } else {
        await app.api.post('subtype-templates', payload);
        app.messages.toast('Subtype template created successfully!', 'success');
      }
      app.modal.close();
      await loadSubtypeTemplates();
    } catch (err) {
      app.messages.action('Failed to save template: ' + (err.message || err), app.modal.body(), 'danger');
    }
  }

  async function deleteSubtypeTemplate(id, name) {
    const confirmed = await app.messages.confirm('Delete subtype template "' + name + '"?', $('#subtype-templates-action-msg'), 'warning');
    if (!confirmed) return;

    try {
      await app.api.delete('subtype-templates/' + encodeURIComponent(id));
      app.messages.toast('Deleted subtype template "' + name + '"', 'success');
      await loadSubtypeTemplates();
    } catch (err) {
      app.messages.toast('Failed to delete template: ' + (err.message || err), 'danger');
    }
  }

  // The templates that may actually be used here: right target kind, and a
  // parent this resource is allowed to sit under. Showing the rest and failing
  // on save is how the old dropdown behaved.
  function applicableTemplates(kind, parentResource) {
    const parentKind = parentResource ? parentResource.kind : null;
    const parentSubType = parentResource ? ((parentResource.metadata || {}).subType || '') : '';
    return subtypeTemplates.filter(function(t) {
      if (t.target_kind && t.target_kind !== kind) return false;
      const types = t.valid_parent_types || [];
      if (types.length && (!parentKind || types.indexOf(parentKind) === -1)) return false;
      const subs = t.valid_parent_subtypes || [];
      if (subs.length && (!parentSubType || subs.indexOf(parentSubType) === -1)) return false;
      return true;
    });
  }

  function refreshSubtypeOptions() {
    const kind = $('#res-kind').val();
    const parentId = $('#res-host-id').val();
    const parent = parentId ? resourcesById[parentId] : null;
    const list = applicableTemplates(kind, parent);
    const current = $('#res-subtype').val();

    // Grouped: the vocabulary is ~120 templates, and even filtered by kind and
    // parent a flat list of that length is not something anyone reads.
    const byCategory = new Map();
    for (const t of list) {
      const cat = t.category || 'Other';
      if (!byCategory.has(cat)) byCategory.set(cat, []);
      byCategory.get(cat).push(t);
    }
    let html = '<option value="">-- Custom / Manual --</option>';
    for (const [cat, items] of [...byCategory].sort((a, b) => a[0].localeCompare(b[0]))) {
      html += '<optgroup label="' + esc(cat) + '">';
      for (const t of items.sort((a, b) => a.name.localeCompare(b.name))) {
        html += '<option value="' + esc(t.slug) + '"' + (t.slug === current ? ' selected' : '') + '>'
          + esc(t.name) + '</option>';
      }
      html += '</optgroup>';
    }
    $('#res-subtype-template').html(html);

    // A subtype already on the resource that is not offered here is worth
    // saying out loud rather than silently resetting: it usually means the
    // resource was reparented somewhere its subtype is not allowed.
    const known = list.some(t => t.slug === current);
    const $help = $('#res-subtype-help');
    if (current && !known) {
      const tmpl = subtypeTemplates.find(t => t.slug === current);
      $help.html(tmpl
        ? '<span class="text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i>'
          + esc(tmpl.name) + ' is not valid under this parent.</span>'
        : '<span class="text-muted">Custom subtype <code>' + esc(current) + '</code>, no template.</span>');
    } else {
      const tmpl = list.find(t => t.slug === current);
      $help.html(tmpl && tmpl.description ? esc(tmpl.description) : '');
    }
  }

  function applySubtypeTemplate() {
    const tmpl = $('#res-subtype-template').val();
    if (!tmpl) { $('#res-subtype-help').html(''); return; }
    $('#res-subtype').val(tmpl);
    const t = subtypeTemplates.find(x => x.slug === tmpl);
    if (!t) { $('#res-subtype-help').html(''); return; }

    // Only fill blanks. Re-picking the same template must never overwrite what
    // the operator has already typed.
    if (t.icon && !$('#res-icon').val()) { $('#res-icon').val(t.icon); updateIconPreview(); }
    if (t.description && !$('#res-tagline').val()) $('#res-tagline').val(t.description);

    // Schema defaults for the fields the template declares.
    const props = (t.schema && t.schema.properties) || {};
    if (props.port && props.port.default && !$('#res-port').val()) $('#res-port').val(props.port.default);

    $('#res-subtype-help').html(esc(t.description || ''));
    // Which panels apply is a function of the subtype now, not just the kind
    // (OAuth Configuration is the one that moved), so re-run the toggle.
    toggleFormFields();
    const id = $('#res-id').val();
    renderDynamicFields(tmpl, id && resourcesById[id] ? resourcesById[id].metadata : {});
  }

