  // Fetch and render the live status/metrics for a service resource (kind ===
  // 'service'). Called when the modal opens and re-called on every agent
  // telemetry frame so the panel stays live. Falls back to the last good data
  // (or a clear message) rather than throwing when the agent is offline.
  async function loadServiceStatus(id) {
    const r = resourcesById[id];
    const $body = $('#service-live-body');
    if (!r || !$body.length) return;

    try {
      const res = await app.api.get(`directory-admin/resources/${id}/driver-metrics`);
      const m = (res && res.metrics) || {};
      $body.html(serviceStatusHtml(r, m));
      const $container = $('#service-live-container');
      if ($container.length) $container.show();
    } catch (err) {
      $body.html(
        '<div class="text-muted small"><i class="fa-solid fa-triangle-exclamation me-1"></i>Live status unavailable: ' +
        esc((err && err.message) || 'agent offline or not bound') + '</div>'
      );
    }
  }

  // Render a service resource's live status card from the driver-metrics
  // response. Handles the different per-subtype shapes (active/cpu/mem/restarts
  ///uptime for systemd/docker/podman/process; next_run/last_run for schedules;
  //status for VMs).
  function serviceStatusHtml(r, m) {
    const meta = r.metadata || {};
    const subType = meta.subType || 'systemd';

    if (subType === 'ilo') return iloStatusHtml(r, m);

    const svc = m.service || {};

    const badge = (on) =>
      `<span class="badge ${on ? 'bg-success' : 'bg-danger'}">${on ? 'Active' : 'Inactive'}</span>`;

    const fmtBytes = (b) => {
      if (b == null) return 'N/A';
      if (b >= 1073741824) return (b / 1073741824).toFixed(2) + ' GiB';
      if (b >= 1048576) return (b / 1048576).toFixed(1) + ' MiB';
      if (b >= 1024) return (b / 1024).toFixed(0) + ' KiB';
      return b + ' B';
    };
    const fmtDur = (s) => {
      if (s == null) return 'N/A';
      const d = moment.duration(s, 'seconds');
      if (d.asDays() >= 1) return Math.floor(d.asDays()) + 'd ' + d.hours() + 'h';
      if (d.asHours() >= 1) return Math.floor(d.asHours()) + 'h ' + d.minutes() + 'm';
      return Math.floor(d.asMinutes()) + 'm ' + d.seconds() + 's';
    };
    const fmtTs = (ts) => ts ? moment(ts).format('YYYY-MM-DD HH:mm') : 'N/A';

    const row = (label, val) =>
      `<div class="col-6 col-md-3"><div class="text-muted small">${label}</div><div class="fw-semibold">${val}</div></div>`;

    let extra = '';
    if (svc.next_run || svc.last_run) {
      extra = `
        <div class="row g-2 mt-1">
          ${row('Next run', fmtTs(svc.next_run))}
          ${row('Last run', fmtTs(svc.last_run))}
          ${row('Triggered', svc.triggered_count != null ? esc(svc.triggered_count) : 'N/A')}
        </div>`;
    }
    if (svc.status) {
      extra += `<div class="mt-2"><span class="badge bg-info">${esc(svc.status)}</span></div>`;
    }

    return `
      <div class="card mb-0 border shadow-sm">
        <div class="card-body p-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <strong><i class="fa-solid fa-cube me-1"></i>${esc(r.name)}</strong>
            ${badge(svc.active !== false)}
          </div>
          <div class="row g-2">
            ${row('Sub type', esc(subType))}
            ${row('State', esc(svc.substate || svc.status || 'N/A'))}
            ${row('CPU', (svc.cpu_usage_percent != null && svc.cpu_usage_percent >= 0)
              ? esc(svc.cpu_usage_percent.toFixed(1)) + '%' : 'N/A')}
            ${row('Memory', fmtBytes(svc.memory_bytes))}
            ${row('Restarts', svc.n_restarts != null ? esc(svc.n_restarts) : 'N/A')}
            ${row('Uptime', fmtDur(svc.uptime_seconds))}
          </div>
          ${extra}
          ${serviceControlsHtml(r, svc, m)}
        </div>
      </div>`;
  }

  // Subtypes whose start/stop/restart means something on the host. Mirrors
  // ThetaAgentDriver.CONTROLLABLE_SUBTYPES -- a timer, a cron entry or a VM has
  // no systemctl lifecycle, and offering a button that can only fail is worse
  // than offering none.
  const CONTROLLABLE_SERVICE_SUBTYPES = new Set(['systemd', 'docker', 'podman', 'openrc']);

  // Start / stop / restart for a registered service, over the agent's signed
  // command channel. Disabled (with the reason in the tooltip) rather than
  // hidden when the agent is offline, so the buttons do not appear and vanish
  // as an agent reconnects.
  function serviceControlsHtml(r, svc, m) {
    const subType = ((r.metadata || {}).subType || 'systemd').toLowerCase();
    if (!CONTROLLABLE_SERVICE_SUBTYPES.has(subType)) return '';

    const offline = !m || m.status !== 'online';
    const active = svc.active !== false;
    const reason = offline ? 'The host agent is not connected' : '';

    const btn = (label, action, cls, icon, disabled, why) =>
      `<button type="button" class="btn btn-sm ${cls} me-1 mb-1" ${disabled ? 'disabled' : ''}
         title="${esc(why || label)}"
         onclick="serviceAction('${r.id}', '${action}')"><i class="fa-solid ${icon} me-1"></i>${esc(label)}</button>`;

    // reload is systemd-only; containers have no equivalent and the driver
    // refuses it rather than quietly restarting instead.
    const reloadBtn = subType === 'systemd'
      ? btn('Reload', 'reload', 'btn-outline-secondary', 'fa-rotate', offline || !active,
            offline ? reason : (active ? 'Re-read the unit\'s configuration' : 'Not running'))
      : '';

    return `
      <hr class="my-3">
      <div class="d-flex align-items-center flex-wrap">
        ${btn('Start', 'start', 'btn-success', 'fa-play', offline || active,
              offline ? reason : (active ? 'Already running' : 'Start this service'))}
        ${btn('Restart', 'restart', 'btn-warning', 'fa-arrows-rotate', offline,
              offline ? reason : 'Stop and start this service')}
        ${btn('Stop', 'stop', 'btn-outline-danger', 'fa-stop', offline || !active,
              offline ? reason : (active ? 'Stop this service' : 'Already stopped'))}
        ${reloadBtn}
        <span class="text-muted small ms-2">${esc(serviceTargetName(r))}${offline ? ' — agent offline' : ''}</span>
      </div>`;
  }

  // Send a lifecycle action to a service, through the same generic
  // driver-action endpoint the iLO power buttons use. stop and restart
  // interrupt something that is running, so they are confirmed; start is not.
  async function serviceAction(resourceId, action) {
    const r = resourcesById[resourceId];
    const target = serviceTargetName(r) || (r && r.name) || 'this service';
    if (action === 'stop' || action === 'restart') {
      const confirmed = await app.messages.confirm(
        `${action === 'stop' ? 'Stop' : 'Restart'} ${target} on its host?`, $('#res-modal'), 'warning');
      if (!confirmed) return;
    }
    try {
      app.messages.action(`Sending '${action}' to ${target}...`, $('#res-modal'), 'info');
      const res = await app.api.post(`directory-admin/resources/${resourceId}/driver-action`,
        { action: 'service_action', subAction: action });
      const result = res && res.result;
      if (result && result.status === 'error') throw new Error(result.message);
      // The agent answers with the command's own stderr in `error` even when
      // the frame itself succeeded -- surfacing that is the difference between
      // "dispatched" and "worked".
      const inner = result && result.result;
      if (inner && inner.error) throw new Error(inner.error);
      app.messages.action(`'${action}' completed on ${target}.`, $('#res-modal'), 'success');
      // systemd takes a moment to settle; re-read rather than guess.
      setTimeout(function(){ loadServiceStatus(resourceId); }, 1500);
    } catch (err) {
      app.messages.action(err.message || `Could not ${action} ${target}`, $('#res-modal'), 'danger');
    }
  }

  // Render an iLO host's live power/health state (kind === 'host', subType
  // === 'ilo') plus its power-control buttons. m.ilo comes from
  // drivers/ilo_driver.js's getMetrics -- a real Redfish read, not a mock.
  function iloStatusHtml(r, m) {
    const ilo = m.ilo || {};
    const on = ilo.powerState === 'On';
    const healthOk = !ilo.health || ilo.health === 'OK';
    const powerBadge = `<span class="badge ${on ? 'bg-success' : 'bg-secondary'}">${esc(ilo.powerState || 'Unknown')}</span>`;
    const healthBadge = ilo.health
      ? `<span class="badge ${healthOk ? 'bg-success' : 'bg-danger'} ms-1">${esc(ilo.health)}</span>`
      : '';

    const btn = (label, action, cls, disabled) =>
      `<button type="button" class="btn btn-sm ${cls} me-1 mb-1" ${disabled ? 'disabled' : ''}
         onclick="iloAction('${r.id}', '${action}')"><i class="fa-solid fa-power-off me-1"></i>${esc(label)}</button>`;

    return `
      <div class="card mb-0 border shadow-sm">
        <div class="card-body p-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <strong><i class="fa-solid fa-server me-1"></i>${esc(r.name)}</strong>
            <span>${powerBadge}${healthBadge}</span>
          </div>
          <div class="row g-2 mb-2">
            <div class="col-6 col-md-3"><div class="text-muted small">Model</div><div class="fw-semibold">${esc(ilo.model || 'N/A')}</div></div>
            <div class="col-6 col-md-3"><div class="text-muted small">Serial</div><div class="fw-semibold">${esc(ilo.serial || 'N/A')}</div></div>
            <div class="col-6 col-md-3"><div class="text-muted small">Power</div><div class="fw-semibold">${esc(ilo.powerState || 'N/A')}</div></div>
            <div class="col-6 col-md-3"><div class="text-muted small">Health</div><div class="fw-semibold">${esc(ilo.health || 'N/A')}</div></div>
          </div>
          <div>
            ${btn('Power On', 'power_on', 'btn-success', on)}
            ${btn('Reboot', 'reboot', 'btn-warning', !on)}
            ${btn('Shutdown', 'shutdown', 'btn-outline-danger', !on)}
            ${btn('Force Off', 'force_off', 'btn-danger', !on)}
          </div>
        </div>
      </div>`;
  }

  // Power-control button handler for an iLO host -- POSTs to the same
  // generic driver-action endpoint agentDesktopControl() uses, with an
  // action name drivers/ilo_driver.js maps to a Redfish ResetType.
  async function iloAction(resourceId, action) {
    const labels = { power_on: 'power on', reboot: 'gracefully reboot', shutdown: 'gracefully shut down', force_off: 'force off (hard power-cut)' };
    const confirmed = await app.messages.confirm(`Are you sure you want to ${labels[action] || action} this server via iLO?`, $('#res-modal'), 'danger');
    if (!confirmed) return;
    try {
      app.messages.action(`Sending '${action}' to iLO...`, $('#res-modal'), 'info');
      const res = await app.api.post(`directory-admin/resources/${resourceId}/driver-action`, { action });
      if (res && res.result && res.result.status === 'error') throw new Error(res.result.message);
      app.messages.action(`iLO '${action}' dispatched.`, $('#res-modal'), 'success');
      setTimeout(function(){ loadServiceStatus(resourceId); }, 2000);
    } catch (err) {
      app.messages.action(err.message || 'iLO action failed', $('#res-modal'), 'danger');
    }
  }

