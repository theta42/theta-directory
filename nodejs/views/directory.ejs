  //
  // This block used to live inside the `detailsTabHtml` template literal, in a
  // nested script tag. That is not a thing you can do: HTML ends a script
  // element at the first closing script tag in the source, whatever JavaScript
  // string it appears to be inside -- including, yes, a comment like this one.
  // So the page's real script element was cut off here, the
  // template literal it was in was left unterminated, the whole block failed to
  // parse -- and EVERY function on this page, the tree renderer included, was
  // silently never defined. The directory rendered as an empty table with the
  // rest of the source printed underneath it.

      
      // The metadata keys the main resource form already renders an input for.
      // A template that declares one of these is not wrong -- `port` really is
      // part of what an `ssh` service is -- but it must not get a SECOND
      // control here bound to the same key. Keep in step with the `metadata`
      // object built in saveResource().
      var PLATFORM_METADATA_KEYS = new Set([
        'subType', 'ip', 'address', 'vmid', 'macAddress', 'os', 'port',
        'externalPort', 'gitRepo', 'installPath', 'systemdService', 'icon',
        'tagline', 'environment', 'isExternalReachable', 'isPublic',
        'isCurrentSite'
      ]);

      // Dynamic subtype schema renderer based on SubtypeTemplate
      async function renderDynamicFields(subType, metadata = {}) {
        if (!subType) {
          $('#dynamic-form-fields').html('');
          $('#subtype-dynamic-details-container').hide();
          return;
        }
        let t = subtypeTemplates.find(x => x.slug === subType);
        if (!t) {
          try {
            const res = await app.api.get('subtype-templates/' + encodeURIComponent(subType));
            t = res && res.template;
          } catch (e) {
            console.error('[directory] could not load subtype template', subType, e);
          }
        }
        const data = { template: t };
        if (data && data.template && data.template.schema && data.template.schema.properties && Object.keys(data.template.schema.properties).length > 0) {
          $('#subtype-schema-header').text((data.template.name || subType) + ' Configuration');
          $('#subtype-schema-slug-badge').text(subType).show();
          const entries = Object.entries(data.template.schema.properties);

          let html = '<div class="row">';
          for (const [key, prop] of entries) {
            const val = metadata[key] !== undefined ? metadata[key] : (prop.default !== undefined ? prop.default : '');
            const colClass = prop.type === 'boolean' ? 'col-12 mb-2' : 'col-md-6 mb-3';
            html += `<div class="${colClass}">
              <label class="form-label fw-semibold">${esc(prop.description || key)}${prop.required ? ' <span class="text-danger">*</span>' : ''}</label>
              ${renderDynamicInput(key, prop, val)}
            </div>`;
          }
          html += '</div>';
          $('#dynamic-form-fields').html(html);
          $('#subtype-dynamic-details-container').show();
        } else if (t) {
          $('#subtype-schema-header').text((t.name || subType) + ' Configuration');
          $('#subtype-schema-slug-badge').text(subType).show();
          $('#dynamic-form-fields').html('<p class="text-muted small mb-0"><i class="fa-solid fa-circle-info me-1 text-primary"></i>This subtype does not declare additional custom schema fields. Standard platform fields apply below.</p>');
          $('#subtype-dynamic-details-container').show();
        } else {
          $('#dynamic-form-fields').html('');
          $('#subtype-dynamic-details-container').hide();
        }
      }

      function renderDynamicInput(key, prop, val) {
        const safeKey = esc(key);
        const placeholder = prop.description ? `placeholder="${esc(prop.description)}"` : '';
        if (prop.type === 'boolean') {
          return `<div class="form-check form-switch">
            <input class="form-check-input dynamic-field" type="checkbox" data-key="${safeKey}" id="dyn-${safeKey}" ${val ? 'checked' : ''}>
            <label class="form-check-label" for="dyn-${safeKey}">${esc(prop.description || key)}</label>
          </div>`;
        }
        if (prop.enum && Array.isArray(prop.enum)) {
          const options = prop.enum.map(v => `<option value="${esc(String(v))}" ${val === v ? 'selected' : ''}>${esc(String(v))}</option>`).join('');
          return `<select class="form-select shadow-sm dynamic-field" data-key="${safeKey}">${options}</select>`;
        }
        if (prop.type === 'array') {
          const list = Array.isArray(val) ? val : (val ? String(val).split(',').map(x => x.trim()).filter(Boolean) : []);
          return `<input type="text" class="form-control shadow-sm dynamic-field" data-key="${safeKey}" ${placeholder}
            value="${esc(list.join(', '))}" title="Comma-separated list">`;
        }
        const inputType = prop.type === 'number' ? 'number' : 'text';
        const valueAttr = val !== undefined && val !== null ? `value="${esc(String(val))}"` : '';
        return `<input type="${inputType}" class="form-control shadow-sm dynamic-field" data-key="${safeKey}" ${placeholder} ${valueAttr}>`;
      }

      // Call renderDynamicFields when subtype changes
      $('#res-subtype-template, #res-subtype').on('change input', function() {
        renderDynamicFields($(this).val());
      });
    
  $(document).on('change', '#res-subtype-template', function() {
    applySubtypeTemplate();
  });

  // ── Read-only view pane ────────────────────────────────────────────────
  //
  // What an operator sees when they open a resource: the facts, laid out, with
  // nothing to accidentally change. Editing is a deliberate switch.

  function fieldRow(label, value, opts) {
    if (value === undefined || value === null || value === '') return '';
    const mono = opts && opts.mono ? ' font-monospace' : '';
    const raw = opts && opts.html;
    return '<div class="row py-1 border-bottom">'
      + '<div class="col-4 col-md-3 text-muted small">' + esc(label) + '</div>'
      + '<div class="col-8 col-md-9 small' + mono + '">' + (raw ? value : esc(value)) + '</div>'
      + '</div>';
  }

  function sectionCard(title, icon, bodyHtml) {
    if (!bodyHtml) return '';
    return '<div class="card mb-3 shadow-sm border">'
      + '<div class="card-header bg-light py-2"><h6 class="mb-0 fw-bold text-dark">'
      + '<i class="' + icon + ' me-1"></i> ' + esc(title) + '</h6></div>'
      + '<div class="card-body py-2">' + bodyHtml + '</div></div>';
  }

  function envBadge(md) {
    const env = md.environment;
    const bubbled = md.bubbled_environment;
    if (!env && !bubbled) return '';
    const cls = { prod: 'bg-danger', testing: 'bg-warning text-dark', dev: 'bg-info text-dark' };
    let html = '';
    if (env) html += '<span class="badge ' + (cls[env] || 'bg-secondary') + ' me-1">' + esc(env) + '</span>';
    // Bubbled but not set here means a child is more critical than this node.
    if (bubbled && bubbled !== env) {
      html += '<span class="badge bg-light text-dark border" title="Inherited from a child resource: this resource is as critical as the most critical thing under it">'
        + '<i class="fa-solid fa-arrow-turn-up me-1"></i>' + esc(bubbled) + ' (from a child)</span>';
    }
    return html;
  }

  function viewPaneHtml(r) {
    if (!r) return '<p class="text-muted">Nothing selected.</p>';
    const md = r.metadata || {};
    const tmpl = subtypeTemplates.find(t => t.slug === (md.subType || ''));

    const style = STATUS_STYLE[md.status];
    const statusHtml = style
      ? '<span class="badge" style="background:' + style.color + '">' + esc(String(md.status).toUpperCase()) + '</span>'
        + ' <span class="text-muted small ms-1">' + esc(md.status_message || style.title) + '</span>'
      : '<span class="text-muted small">Not evaluated</span>';

    let identity = '';
    identity += fieldRow('Name', r.name);
    identity += fieldRow('Slug', r.slug, { mono: true });
    identity += fieldRow('Kind', r.kind);
    identity += fieldRow('Subtype', tmpl ? tmpl.name + ' (' + md.subType + ')' : (md.subType || ''));
    identity += fieldRow('Description', r.description);
    identity += fieldRow('Status', statusHtml, { html: true });
    const env = envBadge(md);
    if (env) identity += fieldRow('Environment', env, { html: true });
    identity += fieldRow('Owner', r.owner);

    let network = '';
    network += fieldRow('IP', md.ip, { mono: true });
    network += fieldRow('Public IP', md.public_ip, { mono: true });
    network += fieldRow('MAC', md.macAddress, { mono: true });
    network += fieldRow('Address', md.address, { mono: true });
    network += fieldRow('Port', md.port);
    network += fieldRow('External port', md.externalPort);

    let platform = '';
    platform += fieldRow('OS', md.os);
    platform += fieldRow('Kernel', md.kernel);
    platform += fieldRow('CPU', md.cpu);
    platform += fieldRow('RAM', md.ram_total_gb ? md.ram_total_gb + ' GB' : '');
    platform += fieldRow('Disk', md.disk_total_gb ? md.disk_total_gb + ' GB' : '');
    platform += fieldRow('Power state', md.powerState);
    platform += fieldRow('VMID', md.vmid);
    platform += fieldRow('Node', md.node);

    // The template's own declared fields, so a subtype's custom properties are
    // legible in View mode instead of only existing on the edit form.
    let custom = '';
    const props = (tmpl && tmpl.schema && tmpl.schema.properties) || {};
    for (const key of Object.keys(props)) {
      let v = md[key];
      if (Array.isArray(v)) v = v.join(', ');
      if (typeof v === 'boolean') v = v ? 'yes' : 'no';
      custom += fieldRow(props[key].description || key, v);
    }

    let place = '';
    const parentEdge = allEdges.find(e => e.childId === r.id && e.relation === 'hosts');
    const parent = parentEdge ? resourcesById[parentEdge.parentId] : null;
    if (parent) {
      place += fieldRow('Parent', '<a href="#" onclick="openEditModal(\'' + parent.id + '\'); return false;">'
        + esc(parent.name) + '</a>', { html: true });
    }
    const kids = allEdges.filter(e => e.parentId === r.id).map(e => resourcesById[e.childId]).filter(Boolean);
    if (kids.length) {
      place += fieldRow('Children', kids.map(k =>
        '<a href="#" class="me-2" onclick="openEditModal(\'' + k.id + '\'); return false;">' + esc(k.name) + '</a>'
      ).join(''), { html: true });
    }

    // Access, including what is inherited from an ancestor.
    let access = '';
    const summary = accessSummary[r.id];
    const direct = (summary && summary.groups) || [];
    const inherited = (summary && summary.inherited) || [];
    if (direct.length) {
      access += fieldRow('Direct grants', direct.map(g =>
        '<span class="badge bg-primary me-1" title="' + esc(g.memberCount) + ' member(s)">' + esc(g.cn) + ' · ' + esc(g.accessLevel) + '</span>'
      ).join(''), { html: true });
    }
    if (inherited.length) {
      access += fieldRow('Inherited', inherited.map(g =>
        '<span class="badge bg-secondary me-1" title="Granted on a parent resource and propagated down">'
        + '<i class="fa-solid fa-arrow-turn-down me-1"></i>' + esc(g.cn) + ' · ' + esc(g.accessLevel) + '</span>'
      ).join(''), { html: true });
    }
    if (!direct.length && !inherited.length) {
      access += inheritsHostAccess(r)
        ? fieldRow('Access', '<span class="text-muted">Follows the host that runs this service.</span>', { html: true })
        : fieldRow('Access', '<span class="text-muted">No group grants this resource.</span>', { html: true });
    }

    let discovery = '';
    discovery += fieldRow('Managed', md.managed ? 'yes' : 'no');
    if (Array.isArray(md.discovery_sources) && md.discovery_sources.length) {
      discovery += fieldRow('Discovered by', md.discovery_sources.join(', '));
    }
    if (md.last_seen) discovery += fieldRow('Last seen', timeAgo(new Date(md.last_seen).toISOString()));

    return sectionCard('Identity', 'fa-solid fa-id-card', identity)
      + sectionCard('Placement', 'fa-solid fa-sitemap', place)
      + sectionCard(tmpl ? tmpl.name + ' Configuration' : (md.subType ? md.subType + ' Configuration' : 'Subtype Configuration'), 'fa-solid fa-shapes', custom)
      + sectionCard('Network', 'fa-solid fa-network-wired', network)
      + sectionCard('Platform', 'fa-solid fa-microchip', platform)
      + sectionCard('Access', 'fa-solid fa-user-group', access)
      + sectionCard('Discovery', 'fa-solid fa-satellite-dish', discovery);
  }

  // View is the default, and it is a real read-only render rather than the
  // edit form with Save hidden.
  function toggleEditMode(isEdit) {
    const id = $('#res-id').val();

    // The General tab swaps between a read-only render and the form. The other
    // tabs (Details, Groups, Children, Secrets) are separate panes that cannot
    // be inside one wrapper, so their inputs are disabled instead -- otherwise
    // "View" would still let you edit everything on the second tab.
    //
    // Scoped to .modal-body, which is what keeps the header's own View/Edit
    // radios out of it: they are the way back out of View mode and disabling
    // them would be a one-way door.
    $('.modal-body input, .modal-body select, .modal-body textarea')
      .prop('disabled', !isEdit);
    // The slug is derived from the name and is never typed into.
    $('#res-slug').prop('disabled', false).prop('readonly', true);

    if (isEdit) {
      $('#resource-view-pane').hide();
      $('#edit-resource-form').show();
      $('.modal-footer .btn-primary').show();
    } else {
      $('#resource-view-pane').html(viewPaneHtml(id ? resourcesById[id] : null)).show();
      $('#edit-resource-form').hide();
      $('.modal-footer .btn-primary').hide();
    }

    // Say which mode this is. The title read "Edit Resource" over a form that
    // could not be edited.
    if (id) $('#sw-modal .modal-title').text(isEdit ? 'Edit Resource' : 'View Resource');
  }

  // A service whose lifecycle an agent reports gets no groups of its own and
  // inherits access from its host. Served from services/subtype_templates.js
  // via routes/index.js, so there is exactly one copy of this table.
  const AGENT_SERVICE_SUBTYPES = new Set(<%- JSON.stringify(agentServiceSubtypes || []) %>);
  function inheritsHostAccess(r) {
    if (!r || (r.kind !== 'service' && r.kind !== 'container')) return false;
    const subType = String((r.metadata || {}).subType || '').toLowerCase();
    // The TEMPLATE is authoritative -- `inherits_host_access` is the same field
    // services/subtype_templates.js answers from, so the tab the UI hides and
    // the groups the server declines to create cannot disagree. This used to
    // read only the server-injected AGENT_SERVICE_SUBTYPES bootstrap Set, which
    // is a mirrored constant: `oauth` became an inheriting subtype and the Set
    // did not know, so an OAuth client was offered a Groups tab for groups that
    // are never provisioned. The Set stays as the fallback for a subtype the
    // template cache has not loaded yet.
    const tpl = subtypeTemplates.find(t => t.slug === subType);
    if (tpl) return Boolean(tpl.inherits_host_access);
    return AGENT_SERVICE_SUBTYPES.has(subType);
  }

  // The unit/container name to act on for a service resource. Mirrors
  // drivers/theta_agent_driver.js's serviceTarget() -- `serviceName` is the
  // generic field the agent reconciler writes; the per-subtype fields are for
  // resources created before it existed. NOT the slug: that is
  // `svc-<host>-<subtype>-<name>`, which is not a unit on any host.
  function serviceTargetName(r) {
    const meta = (r && r.metadata) || {};
    return meta.serviceName || meta.systemdService || meta.dockerContainer || (r && r.name) || '';
  }

  // Find the live ServiceMetric the agent reported for a service resource.
  // The agent is the one bound to the theta-agent service child under the
  // service's host, so the lookup walks the graph.
  function liveServiceMetric(r) {
    const meta = (r && r.metadata) || {};
    let a = null;
    if (allEdges.length) {
      const parentEdges = allEdges.filter(e => e.childId === r.id);
      for (const pe of parentEdges) {
        const parent = resourcesById[pe.parentId];
        if (!parent || parent.kind !== 'host') continue;
        const childIds = allEdges.filter(e => e.parentId === parent.id).map(e => e.childId);
        for (const cid of childIds) {
          const child = resourcesById[cid];
          if (child && child.kind === 'service' && child.metadata?.subType === 'theta-agent' && agentsByResource[cid]) {
            a = agentsByResource[cid];
            break;
          }
        }
        if (a) break;
      }
    }
    if (!a) return { agent: null, svc: null };
    const list = ((a.lastTelemetry || {}).services) || [];
    const want = serviceTargetName(r);
    const subType = meta.subType || 'systemd';
    const svc = list.find(s => s && s.name === want && (!s.subtype || s.subtype === subType))
      || list.find(s => s && s.name === want)
      || null;
    return { agent: a, svc };
  }

  // The same status dot hosts get, for a registered service. A service is only
  // as reachable as the agent that reports it, so an offline agent greys the
  // service out rather than leaving it showing its last known state as if it
  // were current.
  function attachServiceStatus(n) {
    const { agent, svc } = liveServiceMetric(n);
    attachCompositeStatus(n, Boolean(agent));
    if (!agent) return;
    // Preserve legacy tooltip for live service state when agent data is present.
    const md = n.metadata || {};
    let suffix = '';
    if (!agent.isOnline) suffix = 'Host agent offline — service state unknown';
    else if (!svc) suffix = 'Registered, but the agent has not reported it yet';
    else if (svc.load_state === 'not-found') suffix = 'Not present on the host any more';
    else if (svc.active) suffix = 'Active' + (svc.substate ? ' (' + svc.substate + ')' : '');
    else suffix = 'Inactive' + (svc.substate ? ' (' + svc.substate + ')' : '');
    if (suffix) n.statusTitle = (md.status_message || n.statusTitle || 'Service status') + ' — ' + suffix;
  }

  // Status tab body for the resource modal.
  function statusTabHtml(resource) {
    if (!resource) return '';
    const md = resource.metadata || {};

    function statusBadgeClass(status) {
      if (status === 'ok') return 'bg-success';
      if (status === 'warning') return 'bg-warning text-dark';
      if (status === 'critical' || status === 'error') return 'bg-danger';
      return 'bg-secondary';
    }

    const statusHeader = md.status ? `
      <div class="alert alert-light border mb-3 d-flex align-items-center">
        <div class="me-3 fs-3"><span class="badge ${statusBadgeClass(md.status)}">${esc(md.status).toUpperCase()}</span></div>
        <div>
          <h6 class="mb-1 fw-bold">Computed Status</h6>
          <p class="mb-0 small text-muted">${esc(md.status_message || 'Telemetry evaluation passing')}</p>
        </div>
      </div>` : '';

    const agent = resource.agent;
    if (!agent) {
      return statusHeader + `
        <div class="p-3 text-center text-muted">
          <i class="fa-solid fa-microchip fa-3x mb-3"></i>
          <h6>No telemetry available</h6>
          <p class="small">Install the theta-agent or configure a plugin to populate telemetry.</p>
        </div>`;
    }

    const d = agent.lastDiscovery || {};
    const t = agent.lastTelemetry || {};
    const fmtNum = (n) => (n == null || isNaN(n)) ? '0.00' : Number(n).toFixed(2);
    const fmtSize = (bytes) => {
      if (!bytes || bytes <= 0) return '0.00 B';
      const gib = bytes / (1024 * 1024 * 1024);
      if (gib >= 1) return fmtNum(gib) + ' GiB';
      const mib = bytes / (1024 * 1024);
      return fmtNum(mib) + ' MiB';
    };

    const bar = (val) => `<div class="progress" style="height:8px"><div class="progress-bar" style="width:${Math.max(0, Math.min(100, val || 0))}%"></div></div>`;
    const online = agent.isOnline ? '<span class="badge bg-success">Online</span>' : '<span class="badge bg-secondary">Offline</span>';
    const gpu = (t.gpu_usage_percent != null && t.gpu_usage_percent >= 0) ? fmtNum(t.gpu_usage_percent) + '%' : 'N/A';
    const lastSeenIso = agent.lastSeen || (agent.last_seen ? new Date(agent.last_seen * 1000).toISOString() : '');
    const lastSeenStr = timeAgo(lastSeenIso) || 'never';

    // RAM details
    const ram = t.ram_details || d.ram_details || {};
    const totalRamBytes = ram.total_bytes || (d.ram_total_gb ? d.ram_total_gb * 1024 * 1024 * 1024 : 0);
    const usedRamBytes = ram.used_bytes || (totalRamBytes * (t.ram_usage_percent || 0) / 100);
    const bufRamBytes = ram.buffers_cache_bytes || 0;
    const freeRamBytes = ram.free_bytes || Math.max(0, totalRamBytes - usedRamBytes - bufRamBytes);

    const usedRamPct = ram.used_percent != null ? ram.used_percent : (t.ram_usage_percent || 0);
    const bufRamPct = ram.buffers_cache_percent != null ? ram.buffers_cache_percent : 0;
    const freeRamPct = ram.free_percent != null ? ram.free_percent : Math.max(0, 100 - usedRamPct - bufRamPct);

    // CPU details
    const cpuDet = t.cpu_details || d.cpu_details || {};
    const cpuModel = cpuDet.model || d.cpu || 'Unknown CPU';
    const cpuCores = (cpuDet.cores != null && cpuDet.cores > 0) ? cpuDet.cores : (d.cpu_details && d.cpu_details.cores ? d.cpu_details.cores : 'N/A');
    const cpuThreads = (cpuDet.threads != null && cpuDet.threads > 0) ? cpuDet.threads : (d.cpu_details && d.cpu_details.threads ? d.cpu_details.threads : 'N/A');
    const cpuSpeed = cpuDet.mhz ? (cpuDet.mhz >= 1000 ? (cpuDet.mhz / 1000).toFixed(2) + ' GHz' : cpuDet.mhz.toFixed(0) + ' MHz') : '';

    // Disks
    const disks = t.disks || d.disks || [];

    let disksHtml = '';
    if (disks.length > 0) {
      disksHtml = `<div class="table-responsive"><table class="table table-sm text-center small mb-0 align-middle"><thead><tr><th>Device</th><th>Mount</th><th>Type</th><th>FS</th><th>Usage</th><th>Used / Total</th></tr></thead><tbody>` +
        disks.map(dk => `<tr>
          <td><code class="text-dark fw-bold">${esc(dk.device || dk.mountpoint)}</code></td>
          <td><code>${esc(dk.mountpoint)}</code></td>
          <td><span class="badge bg-outline-secondary border text-dark">${esc(dk.drivetype || 'Disk')}</span></td>
          <td><span class="badge bg-light text-dark border">${esc(dk.fstype || 'N/A')}</span></td>
          <td style="min-width: 120px;">
            <div class="d-flex align-items-center gap-1">
              <span class="small font-monospace me-1">${fmtNum(dk.usage_percent)}%</span>
              <div class="progress flex-grow-1" style="height:6px"><div class="progress-bar ${dk.usage_percent > 85 ? 'bg-danger' : 'bg-primary'}" style="width:${Math.max(0, Math.min(100, dk.usage_percent))}%"></div></div>
            </div>
          </td>
          <td>${fmtSize(dk.used_bytes || (dk.total_bytes * (dk.usage_percent || 0) / 100))} / ${fmtSize(dk.total_bytes)}</td>
        </tr>`).join('') + `</tbody></table></div>`;
    } else {
      disksHtml = `<div class="small">Disk Usage: <strong>${fmtNum(t.disk_usage_percent ?? 0)}%</strong> ${bar(t.disk_usage_percent)}</div>`;
    }

    const hd = t.host_details || d.host_details || agent.hostDetails || {};
    let hostDetailsHtml = '';
    if (hd.os || hd.kernel || hd.hardware_model || hd.static_hostname) {
      hostDetailsHtml = `
      <div class="card mb-3 shadow-sm border">
        <div class="card-header bg-light py-2">
          <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-server me-1"></i> System & Hardware Details</h6>
        </div>
        <div class="card-body p-3 small">
          <div class="row g-2">
            <div class="col-md-6"><strong>Static Hostname:</strong> ${esc(hd.static_hostname || d.hostname || 'N/A')}</div>
            <div class="col-md-6"><strong>Operating System:</strong> ${esc(hd.os || d.os || 'N/A')}</div>
            <div class="col-md-6"><strong>Kernel / Arch:</strong> ${esc(hd.kernel || d.kernel || 'N/A')} (${esc(hd.arch || 'x86_64')})</div>
            <div class="col-md-6"><strong>Hardware Model:</strong> ${esc(hd.hardware_vendor || '')} ${esc(hd.hardware_model || 'N/A')}</div>
            <div class="col-md-6"><strong>Chassis:</strong> ${esc(hd.chassis || 'N/A')}</div>
            <div class="col-md-6"><strong>Firmware:</strong> ${esc(hd.firmware_version || 'N/A')} ${hd.firmware_date ? '(' + esc(hd.firmware_date) + ')' : ''}</div>
            <div class="col-md-6"><strong>Machine ID:</strong> <code class="text-muted">${esc(hd.machine_id || 'N/A')}</code></div>
            <div class="col-md-6"><strong>Boot ID:</strong> <code class="text-muted">${esc(hd.boot_id || 'N/A')}</code></div>
          </div>
        </div>
      </div>`;
    }

    const agentVer = d.version || t.version || agent.version || 'v1.8.0';
    const loggedUsers = t.logged_users || d.logged_users || agent.loggedUsers || [];

    let loggedUsersHtml = '';
    if (loggedUsers.length > 0) {
      loggedUsersHtml = `<div class="table-responsive"><table class="table table-sm small mb-0 align-middle">
        <thead><tr><th>User</th><th>Terminal</th><th>Host / IP</th><th>Session Time</th></tr></thead><tbody>` +
        loggedUsers.map(u => `<tr>
          <td><i class="fa-solid fa-user text-primary me-1"></i><strong>${esc(u.user)}</strong></td>
          <td><code class="text-muted">${esc(u.terminal || 'tty')}</code></td>
          <td>${esc(u.host || 'local')}</td>
          <td class="text-muted">${u.started ? moment(u.started * 1000).fromNow() : 'active'}</td>
        </tr>`).join('') + `</tbody></table></div>`;
    } else {
      loggedUsersHtml = `<div class="small text-muted p-2"><i class="fa-solid fa-user-slash me-1"></i>No active logged-in user sessions.</div>`;
    }

    return statusHeader + `<div class="p-3">
      <div class="mb-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
          ${esc(agent.name || agent.hostname || 'unknown')} ${online}
          <span class="badge bg-dark ms-2 font-monospace" title="Theta Agent Binary Version"><i class="fa-solid fa-code-branch me-1"></i>${esc(agentVer)}</span>
        </h5>
        <small class="text-muted">Last seen ${lastSeenStr}</small>
      </div>

      ${hostDetailsHtml}      </div>

      <!-- Memory Card -->
      <div class="card mb-3 shadow-sm border">
        <div class="card-header bg-light py-2">
          <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-memory me-1"></i> Memory</h6>
        </div>
        <div class="card-body p-2">
          <div class="p-2 mb-1 rounded fw-bold" style="background-color: #d0e1fd; color: #084298;">
            Total: <span>${fmtSize(totalRamBytes)}</span>
          </div>
          <div class="p-2 mb-1 rounded" style="background-color: #f8d7da; color: #842029;">
            Used: <strong>${fmtSize(usedRamBytes)}</strong> <em>${fmtNum(usedRamPct)}%</em>
          </div>
          <div class="p-2 mb-1 rounded" style="background-color: #e2e3e5; color: #41464b;">
            Buffer+Cache: <strong>${fmtSize(bufRamBytes)}</strong> <em>${fmtNum(bufRamPct)}%</em>
          </div>
          <div class="p-2 mb-1 rounded" style="background-color: #d1e7dd; color: #0f5132;">
            Free: <strong>${fmtSize(freeRamBytes)}</strong> <em>${fmtNum(freeRamPct)}%</em>
          </div>
          <div class="progress mt-2" style="height: 14px; border-radius: 6px; overflow: hidden;">
            <div class="progress-bar bg-danger" role="progressbar" style="width: ${Math.max(0, Math.min(100, usedRamPct))}%"></div>
            <div class="progress-bar bg-secondary" role="progressbar" style="width: ${Math.max(0, Math.min(100, bufRamPct))}%"></div>
            <div class="progress-bar bg-success" role="progressbar" style="width: ${Math.max(0, Math.min(100, freeRamPct))}%"></div>
          </div>
        </div>
      </div>

      <!-- CPU Card -->
      <div class="card mb-3 shadow-sm border">
        <div class="card-header bg-light py-2">
          <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-microchip me-1"></i> CPU</h6>
        </div>
        <div class="card-body p-3">
          <div class="mb-2"><strong>Model:</strong> ${esc(cpuModel)}</div>
          <div class="mb-2"><strong>Specs:</strong> ${esc(cpuCores)} Cores / ${esc(cpuThreads)} Threads ${cpuSpeed ? '@ ' + esc(cpuSpeed) : ''}</div>
          <div>Usage: <strong>${fmtNum(t.cpu_usage_percent ?? 0)}%</strong> ${bar(t.cpu_usage_percent)}</div>
        </div>
      </div>

      <!-- Disks Card -->
      <div class="card mb-3 shadow-sm border">
        <div class="card-header bg-light py-2">
          <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-hard-drive me-1"></i> Physical Disks & Filesystems</h6>
        </div>
        <div class="card-body p-2">
          ${disksHtml}
        </div>
      </div>

      <!-- Logged-in Users Card -->
      <div class="card mb-3 shadow-sm border">
        <div class="card-header bg-light py-2">
          <h6 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-users me-1"></i> Active Logged-in Users</h6>
        </div>
        <div class="card-body p-2">
          ${loggedUsersHtml}
        </div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-6">GPU <strong>${gpu}</strong></div>
        <div class="col-6">ZFS <strong>${esc(t.zfs_health || 'N/A')}</strong></div>
      </div>

      <!-- Desktop Controls Card -->
      <div class="card mb-3 border-info shadow-sm">
        <div class="card-header bg-info text-dark py-2">
          <h6 class="mb-0 fw-bold"><i class="fa-solid fa-desktop me-1"></i> Desktop Session & Power Controls</h6>
        </div>
        <div class="card-body p-3 d-flex flex-wrap gap-2">
          <button class="btn btn-outline-dark btn-sm" onclick="agentDesktopControl('${agent.id}', 'lock')"><i class="fa-solid fa-lock me-1"></i> Lock Session</button>
          <button class="btn btn-outline-secondary btn-sm" onclick="agentDesktopControl('${agent.id}', 'display_off')"><i class="fa-solid fa-tv me-1"></i> Display Off</button>
          <button class="btn btn-outline-warning btn-sm" onclick="agentDesktopControl('${agent.id}', 'logout')"><i class="fa-solid fa-right-from-bracket me-1"></i> Log Out User</button>
          <button class="btn btn-outline-primary btn-sm" onclick="agentDesktopControl('${agent.id}', 'sleep')"><i class="fa-solid fa-moon me-1"></i> Sleep Host</button>
        </div>
      </div>

      <!-- Host Power Controls -->
      <div class="card mb-3 border-danger shadow-sm">
        <div class="card-header bg-danger text-white py-2">
          <h6 class="mb-0 fw-bold"><i class="fa-solid fa-power-off me-1"></i> Host Power Operations</h6>
        </div>
        <div class="card-body p-3 d-flex gap-2">
          <button class="btn btn-outline-danger btn-sm" onclick="agentReboot('${agent.id}')"><i class="fa-solid fa-arrows-rotate me-1"></i> Reboot Host</button>
          <button class="btn btn-danger btn-sm" onclick="agentShutdown('${agent.id}')"><i class="fa-solid fa-power-off me-1"></i> Shutdown Host</button>
        </div>
      </div>

      <!-- Systemd Service Manager -->
      <div class="card mb-3 border-primary shadow-sm">
        <div class="card-header bg-primary text-white py-2">
          <h6 class="mb-0 fw-bold"><i class="fa-solid fa-gear me-1"></i> Systemd Service Manager</h6>
        </div>
        <div class="card-body p-3">
          <div class="input-group input-group-sm mb-2">
            <span class="input-group-text">Service Name</span>
            <input type="text" class="form-control" id="sysd-service-${agent.id}" placeholder="e.g. nginx, sshd, docker" value="sshd">
            <button class="btn btn-outline-primary" onclick="manageService('${agent.id}', 'status')">Status</button>
            <button class="btn btn-outline-success" onclick="manageService('${agent.id}', 'start')">Start</button>
            <button class="btn btn-outline-warning" onclick="manageService('${agent.id}', 'restart')">Restart</button>
            <button class="btn btn-outline-danger" onclick="manageService('${agent.id}', 'stop')">Stop</button>
          </div>
          <div id="sysd-output-${agent.id}" class="d-none mt-2">
            <pre class="bg-dark text-light p-2 rounded small mb-0" style="max-height: 200px; overflow-y: auto;" id="sysd-text-${agent.id}"></pre>
          </div>
        </div>
      </div>

      <hr><h6>Discovery & Metadata</h6>
      <div class="row small text-muted">
        <div class="col-6">OS: ${esc(d.os || '')}</div>
        <div class="col-6">Kernel: ${esc(d.kernel || '')}</div>
        <div class="col-6">IPs: ${esc((d.ip_addresses || []).join(', '))}</div>
        <div class="col-6">Location: ${esc(d.location || '')}</div>
      </div>
      <hr><h6>Capabilities</h6>
      <div class="small">${capabilitiesHtml(d.capabilities)}</div>
    </div>`;
  }

  // Render the agent's enabled capabilities (reported in its discovery frame) as
  // green/gray badges. service_control is a list, so it renders as its own line.
  function capabilitiesHtml(caps) {
    caps = caps || {};
    const badge = (name, on) => `<span class="badge ${on ? 'bg-success' : 'bg-secondary'} me-1 mb-1">${esc(name)}</span>`;
    const bools = [
      ['Telemetry', caps.telemetry],
      ['LDAP config', caps.configure_ldap],
      ['LDAP tunnel', caps.ldap_tunnel],
      ['Secrets', caps.secrets],
      ['IAM', caps.iam],
      ['Reboot', caps.reboot],
      ['Bash', caps.arbitrary_bash],
    ];
    const sc = Array.isArray(caps.service_control) ? caps.service_control : [];
    const scLine = sc.length
      ? `<div class="mt-1 text-muted">Service control: ${esc(sc.join(', '))}</div>`
      : '';
    return bools.map(([n, on]) => badge(n, !!on)).join('') + scLine;
  }

  async function agentReboot(agentId) {
    const ok = await app.messages.confirm('Are you sure you want to REBOOT this host?');
    if (!ok) return;
    app.api.post(`agent/nodes/${agentId}/command`, { command: 'reboot', isHighRisk: true }, function(err, res) {
      if (err) return app.messages.toast('Reboot failed: ' + (err.message || err), 'danger');
      app.messages.toast('Reboot command sent to host', 'success');
    });
  }

  async function agentShutdown(agentId) {
    const ok = await app.messages.confirm('Are you sure you want to SHUTDOWN this host?');
    if (!ok) return;
    app.api.post(`agent/nodes/${agentId}/command`, { command: 'shutdown', isHighRisk: true }, function(err, res) {
      if (err) return app.messages.toast('Shutdown failed: ' + (err.message || err), 'danger');
      app.messages.toast('Shutdown command sent to host', 'success');
    });
  }

  function manageService(agentId, action) {
    const service = ($(`#sysd-service-${agentId}`).val() || '').trim();
    if (!service) return app.messages.toast('Service name required', 'warning');
    const outBox = $(`#sysd-output-${agentId}`);
    const outText = $(`#sysd-text-${agentId}`);
    outBox.removeClass('d-none');
    outText.text(`Executing systemctl ${action} ${service}...`);
    app.api.post(`agent/nodes/${agentId}/command`, {
      command: 'systemd_action',
      payload: { action, service },
      isHighRisk: action !== 'status'
    }, function(err, res) {
      if (err) {
        outText.text('Error: ' + (err.message || JSON.stringify(err)));
        return;
      }
      outText.text(`Command '${action}' sent for service '${service}'. Check output or logs.`);
    });
  }

  // Re-fetch agents (every 30s + on socket events) so status dots stay live.
  async function refreshAgents() {
    try {
      const res = await app.api.get('agent/nodes');
      indexAgents((res && res.agents) || []);
      agentsUnavailable = false;
      renderTable();
    } catch (e) {
      agentsUnavailable = true;
      renderTable(); // re-render so dots flip to neutral, not stale green
    }
  }

  // "Who can reach this?" at a glance. A resource with no linked group is not a
  // locked-down resource -- it is an unreachable one, and a group whose LDAP
  // entry has been deleted grants nothing, so both get called out rather than
  // rendering as a quiet zero.
  const groupTitle = (list) => list.map(g => g.cn + ' (' + g.accessLevel + ', ' + g.memberCount + ')').join('&#10;');

  function accessCellHtml(resourceId) {
    const summary = accessSummary[resourceId];
    const direct = (summary && summary.groups) || [];
    // Grants that reach this resource from an ancestor. Ownership propagates
    // down the tree, so a host under a granted site is reachable with no row
    // of its own -- showing "no groups" there was actively misleading.
    const inherited = (summary && summary.inherited) || [];

    if (!direct.length && !inherited.length) {
      // A service an agent registered has no groups on purpose: a systemd unit
      // is not an access boundary, so access follows the host that runs it.
      // Saying "no groups" there reads as a misconfiguration when it is the
      // design.
      if (inheritsHostAccess(resourcesById[resourceId])) {
        return '<span class="badge bg-light text-dark border" title="Access follows the host that runs this service">via host</span>';
      }
      return '<span class="badge bg-light text-dark border" title="No LDAP group gates this resource">no groups</span>';
    }

    let html = '';
    if (direct.length) {
      html += '<span class="badge bg-primary" title="Granted directly on this resource&#10;' + groupTitle(direct) +
        '"><i class="fa-solid fa-user-group"></i> ' + summary.memberCount + '</span>';
      html += ' <small class="text-muted">' + direct.length + ' group' + (direct.length === 1 ? '' : 's') + '</small>';
    }
    if (inherited.length) {
      html += (html ? ' ' : '') +
        '<span class="badge bg-secondary" title="Inherited from a parent resource&#10;' + groupTitle(inherited) +
        '"><i class="fa-solid fa-arrow-turn-down"></i> ' + inherited.length + ' inherited</span>';
      if (!direct.length) {
        html += ' <span class="badge bg-primary" title="' + groupTitle(inherited) +
          '"><i class="fa-solid fa-user-group"></i> ' + summary.memberCount + '</span>';
      }
    }
    const dangling = direct.concat(inherited).filter(g => !g.exists);
    if (dangling.length) {
      html += ' <span class="badge bg-warning text-dark" title="Linked group missing in LDAP: ' +
        dangling.map(g => g.cn).join(', ') + '">!</span>';
    }
    return html;
  }

  // Reverse lookup: what can a given user reach? The question an access-control
  // pane must answer and the directory previously could not -- /api/discovery/me
  // only ever answered it for the caller themselves.
  async function openUserAccessModal() {
    const uid = ($('#user-access-uid').val() || '').trim();
    if (!uid) return;
    app.modal.open({ title: 'Access for ' + uid, bodyHtml: '<p class="text-muted">Loading…</p>' });
    try {
      const res = await app.api.get('directory-admin/user-access/' + encodeURIComponent(uid));
      const data = res.results;
      let html;
      if (!data.resources.length) {
        html = '<p class="text-muted">This user is in ' + data.groups.length +
          ' group(s), none of which gate a directory resource.</p>';
      } else {
        html = '<table class="table table-sm"><thead><tr><th>Resource</th><th>Kind</th>' +
          '<th>Via group</th><th>Level</th></tr></thead><tbody>' +
          data.resources.map(function(r) {
            return '<tr><td><a href="/directory/' + encodeURIComponent(r.slug) + '">' + r.name + '</a></td>' +
              '<td><span class="badge bg-secondary">' + r.kind + '</span></td>' +
              '<td><code>' + r.groupCn + '</code></td>' +
              '<td>' + r.accessLevel + '</td></tr>';
          }).join('') + '</tbody></table>';
      }
      app.modal.open({ title: 'Access for ' + data.uid, bodyHtml: html, size: 'lg' });
    } catch (err) {
      app.modal.open({
        title: 'Access for ' + uid,
        bodyHtml: '<p class="text-danger">' + ((err && err.message) || 'Lookup failed') + '</p>'
      });
    }
  }

  function renderTable() {
    const filter = $('#search-filter').val().toLowerCase();
    const sort = $('#sort-by').val();
    const secretsOnly = $('#toggle-secrets-only').is(':checked');

    let filtered = rawResources.filter(r => {
      const hasSec = !!(r.hasSecret || r.metadata?.hasSecret || (r.secretKeys && r.secretKeys.length > 0) || (r.metadata?.secretKeys && r.metadata.secretKeys.length > 0));
      if (secretsOnly && !hasSec) {
        return false;
      }
      if (!filter) return true;
      const secretKeysStr = (r.secretKeys || []).join(' ').toLowerCase();
      return (r.name || '').toLowerCase().includes(filter) ||
             (r.slug || '').toLowerCase().includes(filter) ||
             (r.kind || '').toLowerCase().includes(filter) ||
             (r.metadata?.subType || '').toLowerCase().includes(filter) ||
             (r.metadata?.ip || '').toLowerCase().includes(filter) ||
             (r.hostName || '').toLowerCase().includes(filter) ||
             secretKeysStr.includes(filter);
    });
    
    // Sort
    filtered.sort((a, b) => {
      if (sort === 'name') return a.name.localeCompare(b.name);
      if (sort === 'kind') return a.kind.localeCompare(b.kind) || a.name.localeCompare(b.name);
      if (sort === 'env') {
         const rank = { prod: 0, testing: 1, dev: 2 };
         const ae = rank[a.metadata?.environment] ?? 3;
         const be = rank[b.metadata?.environment] ?? 3;
         return ae - be || a.name.localeCompare(b.name);
      }
      return 0;
    });

    let finalRenderList = [];

    const map = {};
    const roots = [];
    filtered.forEach(r => { map[r.id] = { ...r, children: [] }; });

    filtered.forEach(r => {
      const node = map[r.id];
      if (node.parentId && map[node.parentId]) {
         map[node.parentId].children.push(node);
      } else {
         roots.push(node);
      }
    });

    // Rows are emitted depth-first, so a node's descendants are exactly the
    // rows that follow it until depth drops back to its own. `data-depth` is
    // what applyTreeCollapse() below walks -- that ordering is the whole
    // mechanism, so keep the traversal depth-first if you change this.
    const flatten = (nodes, depth) => {
       nodes.forEach(n => {
         let indentHtml = '';
         for(let i = 0; i < depth; i++) {
            indentHtml += '<span style="display:inline-block; width: 1.5rem;"></span>';
         }
         if (depth > 0) {
            indentHtml += '<i class="fa-solid fa-turn-up fa-rotate-90 text-muted me-2"></i>';
         }
         n.indentHtml = indentHtml;
         n.depth = depth;
         n.displayName = (n.name && n.name.length > 16) ? n.name.substring(0, 16) + '…' : (n.name || '');
         // A leaf gets a spacer of the same width, so names stay aligned down
         // the column instead of jittering by whether a row has children.
         n.caretHtml = n.children.length
           ? '<button type="button" class="btn btn-link btn-sm p-0 me-1 text-reset tree-caret" '
             + 'onclick="toggleTreeNode(\'' + n.id + '\'); return false;" '
             + 'aria-label="Expand or collapse ' + escapeHtmlAttr(n.name || '') + '" '
             + 'title="Expand/collapse"><i class="fa-solid fa-chevron-down fa-fw"></i></button>'
           : '<span class="d-inline-block me-1" style="width:1.1rem"></span>';
         n.childCount = n.children.length;
         n.accessHtml = accessCellHtml(n.id);
         n.isArchived = (n.metadata || {}).lifecycle_state === 'archived' && (n.metadata || {}).managed !== true;
         // Environment bubbles up, and was being computed and then never shown:
         // a site carrying production looked identical to an empty one.
         const nmd = n.metadata || {};
         n.inheritedEnv = (!nmd.environment && nmd.bubbled_environment) ? nmd.bubbled_environment : '';
         if (n.kind === 'host') attachAgentStatus(n);
         else if (n.kind === 'service') attachServiceStatus(n);
         else attachCompositeStatus(n, false);
         finalRenderList.push(n);
         if (n.children.length > 0) {
           flatten(n.children, depth + 1);
         }
       });
    };

    flatten(roots, 0);

    $.scope.resources.empty();
    for (const r of finalRenderList) {
      $.scope.resources.push(r);
    }

    applyTreeCollapse();
  }
  
  // ── Collapsible tree ───────────────────────────────────────────────────────
  // Which nodes are collapsed, by resource id. Persisted so the shape of the
  // tree survives a refresh (and the Directory self-heal reload that follows
  // most edits) -- a tree that re-expands every time is worse than no tree.
  var TREE_COLLAPSE_KEY = 'directory.collapsedNodes';

  function loadCollapsed() {
    try {
      const raw = localStorage.getItem(TREE_COLLAPSE_KEY);
      return new Set(raw ? JSON.parse(raw) : []);
    } catch (e) { return new Set(); }
  }

  function saveCollapsed(set) {
    try { localStorage.setItem(TREE_COLLAPSE_KEY, JSON.stringify([...set])); } catch (e) {}
  }

  function escapeHtmlAttr(s) {
    return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  // Hide every row beneath a collapsed node and point its caret sideways.
  // Rows are in depth-first order, so "beneath" is the run of following rows
  // with a greater depth. A node inside an already-hidden run stays hidden
  // regardless of its own state, which is what makes nesting work.
  function applyTreeCollapse() {
    const $rows = $('#resources-list tr');

    // While a search is active every match must be visible, even one sitting
    // under a collapsed ancestor -- otherwise searching silently returns
    // nothing and looks broken. The collapsed set is left untouched, so the
    // tree springs back to its saved shape as soon as the box is cleared.
    if (($('#search-filter').val() || '').trim()) {
      $rows.show();
      $rows.find('.tree-caret i').removeClass('fa-chevron-right').addClass('fa-chevron-down');
      return;
    }

    const collapsed = loadCollapsed();
    let hideBelowDepth = null;

    $rows.each(function() {
      const $row = $(this);
      const depth = parseInt($row.attr('data-depth') || '0', 10);
      const id = ($row.attr('id') || '').replace('resource-row-', '');

      if (hideBelowDepth !== null && depth > hideBelowDepth) {
        $row.hide();
        return; // still inside a collapsed subtree; its own state is moot
      }
      hideBelowDepth = null;
      $row.show();

      // Visual state lives on the .tree-caret BUTTON, rotated by CSS, and the
      // hide decision is made from `collapsed` alone.
      //
      // This used to read `.tree-caret i` and bail out when it found nothing.
      // Font Awesome runs in SVG-with-JS mode here: its mutation observer
      // rewrites every <i class="fa-..."> into an <svg>, so moments after a
      // render that selector matches nothing, the function returned early
      // WITHOUT setting hideBelowDepth, and collapsing silently did nothing at
      // all. Never make the collapse logic depend on an element another library
      // is free to replace.
      const $caret = $row.find('.tree-caret');
      if (!$caret.length) return;   // leaf row: nothing to collapse
      if (collapsed.has(id)) {
        $caret.addClass('tree-caret-collapsed');
        hideBelowDepth = depth;
      } else {
        $caret.removeClass('tree-caret-collapsed');
      }
    });
  }

  function toggleTreeNode(id) {
    const collapsed = loadCollapsed();
    if (collapsed.has(id)) collapsed.delete(id); else collapsed.add(id);
    saveCollapsed(collapsed);
    applyTreeCollapse();
  }

  function expandAllTree() {
    saveCollapsed(new Set());
    applyTreeCollapse();
  }

  // Collapse every row that has children. Reads the ids out of the rendered
  // rows rather than the resource list so it can only ever collapse something
  // that is actually on screen and actually has a caret.
  function collapseAllTree() {
    const collapsed = new Set();
    $('#resources-list tr').each(function() {
      const $row = $(this);
      if (!$row.find('.tree-caret').length) return;
      collapsed.add(($row.attr('id') || '').replace('resource-row-', ''));
    });
    saveCollapsed(collapsed);
    applyTreeCollapse();
  }

  function toggleFormFields() {
    const kind = $('#res-kind').val();
    if (kind === 'host') {
      $('#host-parent-container').show();
      $('#host-details-container').show();
      $('#service-ports-container').hide();
      $('#service-details-container').hide();
      $('#oauth-details-container').hide();
      $('#external-container').hide();
      $('#public-container').hide();
      $('#site-details-container').hide();
    } else if (kind === 'service') {
      // OAuth Configuration is keyed off the SUBTYPE now, not a kind of its
      // own: an OAuth client is one more thing a service exposes.
      const isOAuth = isOAuthSubtype($('#res-subtype').val());
      $('#host-parent-container').show();
      $('#host-details-container').hide();
      $('#service-ports-container').toggle(!isOAuth);
      $('#service-details-container').toggle(!isOAuth);
      $('#oauth-details-container').toggle(isOAuth);
      $('#external-container').toggle(!isOAuth);
      $('#public-container').toggle(!isOAuth);
      $('#site-details-container').hide();
    } else { // site
      $('#host-parent-container').hide();
      $('#host-details-container').hide();
      $('#service-ports-container').hide();
      $('#service-details-container').hide();
      $('#oauth-details-container').hide();
      $('#external-container').hide();
      $('#public-container').hide();
      $('#site-details-container').show();
    }
    populateHostDropdown($('#res-host-id').val());
    refreshSubtypeOptions();
  }

  // Reparenting changes which subtypes are legal, so the list has to follow it.
  $(document).on('change', '#res-host-id', function() { refreshSubtypeOptions(); });

  // Clear the live service-status panel's tracked state when the modal closes.
  $(document).on('hidden.bs.modal', function(){
