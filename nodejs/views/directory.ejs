  // Live updates.
  //
  // This table is DERIVED: hierarchy comes from the edge list, hostName from the
  // parent resource, agent status from a separate service, and renderTable()
  // recomputes indentation and carets from the resulting tree. Patching a single
  // row in place (what app.sync.bind does, and the right choice for a flat list)
  // would leave all of that stale -- a new child would render at the wrong depth
  // with no caret on its parent. So a change re-derives the whole view instead.
  //
  // loadResources() -> renderTable() re-reads the search, sort and secrets-only
  // controls, so the operator's current filter survives a reload untouched.
  //
  // Debounced because one edit commonly emits several events (the resource, its
  // group, an edge), and because a bulk import emits a burst.
  function startLiveUpdates(){
    let timer = null;
    const reload = function(){
      clearTimeout(timer);
      timer = setTimeout(function(){ loadResources(); }, 400);
    };
    // Only these carry a socket read gate server-side
    // (utils/socket_pubsub.js); anything else never arrives.
    app.subscribe(/^model:Resource:/, reload);
    app.subscribe(/^model:ResourceGroup:/, reload);

    // The Discovery Plugins tab renders from its own fetch, so it reloads
    // separately. (views/plugins.ejs is dead — /plugins redirects here and the
    // UI was ported into this file.)
    let pluginTimer = null;
    app.subscribe(/^model:PluginInstance:/, function(){
      clearTimeout(pluginTimer);
      pluginTimer = setTimeout(function(){ loadDiscoveryPlugins(); }, 400);
    });
  }
  
  var agentsByResource = {};
  var agentsById = {};
  var agentsUnavailable = false;

  async function loadResources() {
    directoryUserCache = null;
    try {
      const [resResources, resGroups, resEdges, resAccess, resAgents] = await Promise.all([
        app.api.get('directory-admin/resources'),
        app.api.get('directory-admin/groups'),
        app.api.get('directory-admin/edges'),
        app.api.get('directory-admin/access-summary').catch(function(){ return {results: {}}; }),
        app.api.get('agent/nodes')
          .then(function(res){ agentsUnavailable = false; return res; })
          .catch(function(){ agentsUnavailable = true; return {agents: []}; })
      ]);

      accessSummary = (resAccess && resAccess.results) || {};
      resourcesById = {};

      for (const r of resResources.results) {
        r.metadata = r.metadata || {};
        resourcesById[r.id] = r;
      }

      indexAgents((resAgents && resAgents.agents) || []);
      if (!subtypeTemplates.length) await loadSubtypeTemplates();
      
      allGroups = resGroups.results;
      allEdges = resEdges.results;

      rawResources = [];
      for (const r of resResources.results) {
        r.hostName = '—';
        r.parentId = null;
        const parentEdge = allEdges.find(e => e.childId === r.id);
        if (parentEdge) {
           r.parentId = parentEdge.parentId;
           const parent = resourcesById[parentEdge.parentId];
           if (parent) r.hostName = parent.name;
        }
        rawResources.push(r);
      }
      
