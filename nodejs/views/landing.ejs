<%- include('top') %>

<style>
.catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
}
.service-card {
    height: 100%;
    transition: transform .15s, box-shadow .15s;
    display: flex;
    flex-direction: column;
}
.service-card:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
.service-card .card-body { flex: 1; }
.card-icon {
    font-size: 1.4rem;
    width: 1.8rem;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.card-icon-img {
    width: 1.8rem;
    height: 1.8rem;
    object-fit: contain;
}
.howto code {
    display: block;
    background: var(--bs-tertiary-bg, #f1f3f5);
    color: var(--bs-body-color);
    padding: .4rem .6rem;
    border-radius: .25rem;
    font-size: .8rem;
    word-break: break-all;
}
.empty-note { color: var(--bs-secondary-color, #6c757d); font-style: italic; }
/* The status dot sits on the title line, optically centred against the text
   rather than the line box -- a raw fa-circle at this size reads as sitting
   too high next to a heading. */
.status-dot { font-size: .55rem; line-height: 1; padding-top: .45rem; flex: 0 0 auto; }
.howto code { display: block; }
.howto code:first-child { font-weight: 600; }
</style>

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <input type="text" id="catalog-search" class="form-control shadow-sm"
                   placeholder="Search for a service..." onkeyup="renderAll()">
        </div>
    </div>

    <div id="my-requests-section" style="display:none;">
        <h3 class="mb-3"><i class="fa-solid fa-hourglass-half text-warning"></i> My Requests</h3>
        <ul class="list-group mb-5 shadow-sm" id="my-requests"></ul>
    </div>

    <div id="approvals-section" style="display:none;">
        <h3 class="mb-3"><i class="fa-solid fa-user-check text-danger"></i> Awaiting My Approval</h3>
        <ul class="list-group mb-5 shadow-sm" id="approvals"></ul>
    </div>

    <!-- One grid. The Services/Hosts tabs are gone with hosts themselves:
         browsing machines is a different job for a different audience, and it
         lives in the directory. -->
    <div class="card shadow mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fa-solid fa-layer-group text-success"></i> Yours</span>
        </div>
        <div class="card-body">
            <div class="catalog-grid" id="my-services"></div>
        </div>
    </div>

    <h3 class="mb-3"><i class="fa-solid fa-compass text-secondary"></i> Available to request</h3>
    <p class="text-muted small">Things you don't have access to yet. Request what you need.</p>
    <div class="catalog-grid mb-5" id="other-services"></div>

    <p class="text-muted small" id="catalog-admin-note" style="display:none;">
        <i class="fa-solid fa-circle-info"></i>
        Only services an admin has marked <strong>Show in catalog</strong> appear here.
        Everything else lives in the <a href="/directory">directory</a>.
    </p>
</div>

<script type="text/javascript">
    app.auth.forceLogin();

    // Connection conventions from conf/base.js `directory`, injected server-side
    // so the "how to reach this" block renders the invocation that actually
    // works in this deployment rather than a guess.
    var DIRECTORY_CONF = <%- JSON.stringify(directoryConf) %>;

    var state = { mine: [], others: [], requests: [], approvals: [], uid: null, isAdmin: false };

    // Same groups directory.ejs gates itself on. Used only to decide whether a
    // card offers a link into the directory -- sending someone who cannot open
    // that page to it is a dead end, and for the audience this page is built
    // for a 79-row graph view is a dead end even when it does open.
    var DIRECTORY_ADMIN_GROUPS = ['app_sso_admin', 'app_sso_directory_admin', 'admin'];

    // What belongs on this page. A catalog entry is an `http` service an admin
    // has explicitly marked -- never a host, never everything that happens to
    // be in the directory.
    //
    // Before this, the page rendered every managed resource it could see. On a
    // directory with a Proxmox cluster in it that meant a user with no access
    // at all was shown 76 cards -- 41 LXC containers, 12 VMs, 3 hypervisors --
    // 27 of which had no address to reach them by. That is not discovery, and
    // it published the shape of the estate to anyone with an account.
    function isCatalogEntry(r) {
        if (!r || r.kind !== 'service') return false;
        var md = r.metadata || {};
        if (isOAuthSubtype(md.subType)) return false;
        return md.catalog === true;
    }

    var KIND_ICONS = {
        site:    'fa-solid fa-city',
        host:    'fa-solid fa-server',
        service: 'fa-solid fa-cube',
        oauth:   'fa-solid fa-key'  // legacy kind fallback; oauth is a service subtype
    };

    // A credential registration is not somewhere a person browses to, so these
    // are filtered out of the catalog rather than offered as a service card.
    //
    // Deliberately NOT the same list as models/oauth_client.js's
    // OAUTH_SUBTYPES, which answers a different question: that one is "gets
    // OAuth client credentials minted", and `saml-sp` is not that (SAML is a
    // different protocol, unimplemented here). It is still a credential
    // registration, so it still does not belong on the catalog page.
    var IDENTITY_REGISTRATION_SUBTYPES = ['oauth', 'oidc-client', 'saml-sp'];
    function isOAuthSubtype(subType) {
        return IDENTITY_REGISTRATION_SUBTYPES.indexOf(String(subType || '').toLowerCase()) !== -1;
    }

    function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
            return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
        });
    }

    // Render icon as either Font Awesome class or <img> for URL
    function renderIcon(icon, kind) {
        if (!icon) icon = KIND_ICONS[kind] || 'fa-solid fa-cube';
        // If it starts with http, treat it as an image URL
        if (/^https?:\/\//i.test(icon)) {
            return '<img src="' + esc(icon) + '" alt="" class="card-icon-img">';
        }
        // Otherwise it's a Font Awesome class
        return '<i class="' + esc(icon) + ' card-icon"></i>';
    }

    // "How do I actually use this?" — the question the directory exists to
    // answer and the one the old portal never did. Everything here is derived
    // from directory metadata; nothing is hardcoded per-service.
    // Build a URL from the `http` subtype's two halves. External wins when it
    // has an FQDN -- that is the name a person off the LAN can actually use --
    // and the internal address (which may be blank, and resolved from the
    // parent host server-side) is the fallback.
    function urlFor(r) {
        var md = r.metadata || {};

        if (md.fqdn) {
            var ePort = md.externalPort;
            var eScheme = md.externalIsHTTPS === false ? 'http' : 'https';
            var eDefault = eScheme === 'https' ? 443 : 80;
            return eScheme + '://' + md.fqdn + (ePort && Number(ePort) !== eDefault ? ':' + ePort : '');
        }

        var addr = r.resolvedAddress || md.address || md.ip;
        if (!addr) return null;
        // An address that is already a URL is used as-is, whatever its scheme.
        // This is also what stops an `ssh://` address being rewritten into
        // `https://ssh://host:2222:2222`, which is what the old code produced
        // for every ssh service on the page.
        if (/^[a-z][a-z0-9+.-]*:\/\//i.test(addr)) return addr;

        var scheme = md.isHTTPS === false ? 'http' : (md.isHTTPS ? 'https' : 'https');
        var port = md.port;
        var dflt = scheme === 'https' ? 443 : 80;
        return scheme + '://' + addr + (port && Number(port) !== dflt ? ':' + port : '');
    }

    // "How do I actually use this?" — the question the directory exists to
    // answer and the one the old portal never did. Everything here is derived
    // from directory metadata; nothing is hardcoded per-service.
    function howTo(r) {
        var md = r.metadata || {};
        var addr = r.resolvedAddress || md.address || md.ip;
        var lines = [];

        var sshMatch = /^ssh:\/\/([^:/]+)(?::(\d+))?/i.exec(addr || '');
        var isJump = md.subType === 'jump-host' || md.subType === 'ssh';

        if (isJump || sshMatch) {
            // The jump host is the one card that answers a host question, and
            // it has to: hosts are no longer on this page, and the jump-host
            // username grammar existed nowhere else in the product. One string,
            // no interactive menu, so it works in WinSCP and FileZilla as well
            // as a terminal.
            var jumpHost = (sshMatch && sshMatch[1]) || DIRECTORY_CONF.jumpHost || md.fqdn || addr;
            var jumpPort = (sshMatch && sshMatch[2]) || md.port || DIRECTORY_CONF.defaultSshPort;
            var portArg = String(jumpPort) === '22' ? '' : ' -p ' + jumpPort;
            if (jumpHost) {
                lines.push('ssh ' + state.uid + '_-_MACHINE@' + jumpHost + portArg);
                lines.push('# replace MACHINE with the name of the host you want');
            }
            // A jump host usually has a web UI too; show it when it is not the
            // ssh:// address we just parsed.
            var webUrl = md.fqdn ? urlFor(r) : null;
            if (webUrl) lines.unshift(webUrl);
            return lines;
        }

        var url = urlFor(r);
        if (url) lines.push(url);
        return lines;
    }

    // The "Open" button. Only ever an http(s) URL -- an ssh:// address is an
    // instruction, not something a browser can follow, and rendering it as a
    // link produced a button that silently did nothing.
    function linkFor(r) {
        var url = urlFor(r);
        if (!url || !/^https?:\/\//i.test(url)) return null;
        return url;
    }

    // The status dot. `catalogStatus` is resolved server-side
    // (Resource.withCatalogStatus): the entry's own status if it has one,
    // otherwise the nearest ancestor host's, climbing while the trouble
    // continues so a dead hypervisor is named rather than the service on it.
    //
    // `unknown` is drawn hollow rather than grey-filled, and says "no health
    // check" on hover. Nothing probes HTTP endpoints yet, so on a fresh
    // install that is the honest answer for most entries -- and a dot that
    // admits it knows nothing is worth more than one that implies trouble.
    var STATUS_UI = {
        ok:       { cls: 'text-success',   icon: 'fa-solid fa-circle',       label: 'Reachable' },
        warning:  { cls: 'text-warning',   icon: 'fa-solid fa-circle',       label: 'Degraded' },
        critical: { cls: 'text-danger',    icon: 'fa-solid fa-circle',       label: 'Down' },
        error:    { cls: 'text-danger',    icon: 'fa-solid fa-circle',       label: 'Down' },
        unknown:  { cls: 'text-secondary', icon: 'fa-regular fa-circle',     label: 'No health check' }
    };

    function statusHtml(r) {
        var cs = r.catalogStatus || {};
        var ui = STATUS_UI[cs.state] || STATUS_UI.unknown;
        var title = ui.label;
        if (cs.from) title += ' — ' + cs.from;
        else if (cs.via === 'ancestor') title += ' (from its host)';
        return '<span class="status-dot ' + ui.cls + '" title="' + esc(title) + '">'
             + '<i class="' + ui.icon + '"></i></span>';
    }

    function cardHtml(r, accessible) {
        var md = r.metadata || {};
        var blurb = md.tagline || r.description || 'No description provided';
        var href = accessible ? linkFor(r) : null;
        var lines = accessible ? howTo(r) : [];

        var badges = '';
        if (md.isPublic) badges += '<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle ms-1">No login needed</span>';
        if (md.fqdn) badges += '<span class="badge bg-info ms-1">External</span>';

        var footer;
        if (accessible) {
            footer = href
                ? '<a class="btn btn-sm btn-success w-100" target="_blank" rel="noopener" href="' + esc(href) + '">Open <i class="fa-solid fa-arrow-up-right-from-square"></i></a>'
                : '<span class="badge bg-success">Access granted</span>';
        } else if (md.requestable === false) {
            footer = '<span class="badge bg-secondary">Not requestable</span>';
        } else if (state.requests.some(function(q){ return q.resourceId === r.id && q.status === 'pending'; })) {
            footer = '<span class="badge bg-warning text-dark">Request pending</span>';
        } else {
            footer = '<button class="btn btn-sm btn-outline-primary w-100" onclick="requestAccess(\'' + esc(r.id) + '\')">'
                   + '<i class="fa-solid fa-hand"></i> Request access</button>';
        }

        var iconHtml = renderIcon(md.icon, r.kind);

        return '<div class="card shadow-sm service-card ' + (accessible ? 'border-success' : '') + '">'
            + '<div class="card-body">'
            +   '<h5 class="card-title d-flex align-items-start gap-2">'
            +     statusHtml(r)
            +     '<span class="flex-grow-1">' + esc(r.name) + '</span>'
            +     iconHtml
            +   '</h5>'
            +   '<div class="mb-2">' + badges
            +     (state.isAdmin
                    ? '<a class="badge bg-light text-dark border ms-1 text-decoration-none"'
                      // /directory/<slug>, the form app.modal.deepLinkSlug
                      // reads (it parses location.pathname, not the hash).
                      // routes/index.js already serves it.
                      + ' href="/directory/' + encodeURIComponent(r.slug) + '"'
                      + ' title="Open this entry in the directory">'
                      + '<i class="fa-solid fa-diagram-project"></i> Directory</a>'
                    : '')
            +   '</div>'
            +   '<p class="card-text small text-muted">' + esc(blurb) + '</p>'
            +   (lines.length
                  ? '<div class="howto small"><div class="text-muted mb-1">How to reach it</div>'
                    + lines.map(function(l){ return '<code>' + esc(l) + '</code>'; }).join('')
                    + '</div>'
                  : '')
            + '</div>'
            + '<div class="card-footer bg-transparent border-top-0">' + footer + '</div>'
            + '</div>';
    }

    function matchesFilter(r) {
        var q = ($('#catalog-search').val() || '').toLowerCase();
        if (!q) return true;
        var md = r.metadata || {};
        return [r.name, r.slug, r.description, md.tagline, md.fqdn, md.address]
            .filter(Boolean).join(' ').toLowerCase().indexOf(q) !== -1;
    }

    function renderGrid(elId, list, accessible, emptyNote) {
        var items = list.filter(matchesFilter);
        var el = document.getElementById(elId);
        if (!items.length) {
            el.innerHTML = '<p class="empty-note">' + esc(emptyNote || 'Nothing to show here.') + '</p>';
            return;
        }
        el.innerHTML = items.map(function(r){ return cardHtml(r, accessible); }).join('');
    }

    function renderRequests() {
        var open = state.requests.filter(function(q){ return q.status === 'pending'; });
        document.getElementById('my-requests-section').style.display = open.length ? '' : 'none';
        document.getElementById('my-requests').innerHTML = open.map(function(q){
            var label = q.resource ? q.resource.name : q.groupCn;
            return '<li class="list-group-item d-flex justify-content-between align-items-center">'
                + '<span><strong>' + esc(label) + '</strong> '
                + '<small class="text-muted">via <code>' + esc(q.groupCn) + '</code></small></span>'
                + '<button class="btn btn-sm btn-outline-danger" onclick="withdraw(\'' + esc(q.id) + '\')">Withdraw</button>'
                + '</li>';
        }).join('');
    }

    function renderApprovals() {
        document.getElementById('approvals-section').style.display = state.approvals.length ? '' : 'none';
        document.getElementById('approvals').innerHTML = state.approvals.map(function(q){
            var label = q.resource ? q.resource.name : q.groupCn;
            return '<li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">'
                + '<span><strong>' + esc(q.uid) + '</strong> requests <strong>' + esc(label) + '</strong> '
                + '<small class="text-muted">(<code>' + esc(q.groupCn) + '</code>)</small>'
                + (q.note ? '<br><small class="text-muted">' + esc(q.note) + '</small>' : '')
                + '</span>'
                + '<span class="d-flex gap-2">'
                +   '<button class="btn btn-sm btn-success" onclick="decide(\'' + esc(q.id) + '\',\'approve\')">Approve</button>'
                +   '<button class="btn btn-sm btn-outline-danger" onclick="decide(\'' + esc(q.id) + '\',\'deny\')">Deny</button>'
                + '</span></li>';
        }).join('');
    }

    function renderAll() {
        renderGrid('my-services', state.mine, true,
            'Nothing yet. Anything you can request is below.');
        renderGrid('other-services', state.others, false,
            'Nothing left to request — you have access to everything in the catalog.');
        renderRequests();
        renderApprovals();
        var note = document.getElementById('catalog-admin-note');
        if (note) note.style.display = state.isAdmin ? '' : 'none';
    }

    async function load() {
        var me = await app.auth.asyncUser;
        state.uid = me.uid;
        var myGroups = me.groups || [];
        state.isAdmin = DIRECTORY_ADMIN_GROUPS.some(function(g){ return myGroups.indexOf(g) !== -1; });

        // Both endpoints are the *discovery* API, not directory-admin. The old
        // portal called directory-admin/resources and swallowed the 403, so
        // "Discover More" was permanently empty for every non-admin — i.e. for
        // exactly the people it was built for.
        var mineRes = await app.api.get('discovery/me');
        var allRes  = await app.api.get('discovery/resources');

        // isCatalogEntry is applied to BOTH lists. The OAuth exclusion used to
        // be applied only to `others`, so a credential registration you held
        // access to -- which every operator does for the proxy and jump host
        // OAuth clients -- was offered as a service card despite the comment
        // above saying those are filtered out. `catalog === true` subsumes it.
        state.mine = (mineRes.results || []).filter(isCatalogEntry);

        var mineIds = {};
        state.mine.forEach(function(r){ mineIds[r.id] = true; });

        // "Available to request" is three predicates, not one. It used to be
        // `everything minus mine`, which on a directory with a Proxmox cluster
        // meant 76 cards of machines the viewer had never heard of.
        state.others = (allRes.results || []).filter(function(r){
            if (mineIds[r.id] || !isCatalogEntry(r)) return false;
            // A card you cannot act on is worse than no card: the old page
            // rendered a dead "Not requestable" badge and offered nothing else.
            return (r.metadata || {}).requestable !== false;
        });

        // Requests are best-effort: a failure here must not blank the catalog.
        try {
            var mineReq = await app.api.get('access-requests/mine');
            state.requests = mineReq.results || [];
        } catch (e) { state.requests = []; }
        try {
            var pending = await app.api.get('access-requests');
            state.approvals = pending.results || [];
        } catch (e) { state.approvals = []; }

        renderAll();
    }

    async function requestAccess(id) {
        var resource = state.others.find(function(r){ return r.id === id; });
        if (!resource) return;
        app.modal.open({
            title: 'Request access to ' + resource.name,
            bodyHtml: '<div class="actionMessage" style="display:none"></div>'
                + '<p class="text-muted small">Your request goes to the resource owner for approval.</p>'
                + '<label class="form-label">Why do you need it? <span class="text-muted">(optional)</span></label>'
                + '<textarea id="req-note" class="form-control" rows="3"></textarea>',
            footer: {
                buttonsHtml: '<button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>'
                    + '<button class="btn btn-primary ms-2" onclick="submitRequest(\'' + esc(id) + '\')">Send request</button>'
            }
        });
    }

    async function submitRequest(id) {
        try {
            await app.api.post('access-requests', { resourceId: id, note: $('#req-note').val() });
            app.modal.close();
            app.messages.toast('Request sent', 'success');
            await load();
        } catch (err) {
            app.messages.action((err && err.message) || 'Could not send request', app.modal.body(), 'danger');
        }
    }

    async function withdraw(id) {
        try {
            await app.api.delete('access-requests/' + id);
            await load();
        } catch (err) {
            app.messages.toast((err && err.message) || 'Could not withdraw', 'danger');
        }
    }

    async function decide(id, action) {
        try {
            await app.api.post('access-requests/' + id + '/' + action, {});
            app.messages.toast('Request ' + (action === 'approve' ? 'approved' : 'denied'), 'success');
            await load();
        } catch (err) {
            app.messages.toast((err && err.message) || 'Could not update request', 'danger');
        }
    }

    function reload(){
        load().catch(function(e){
            console.error('Failed to load catalog:', e);
            app.messages.toast('Could not load the catalog', 'danger');
        });
    }

    $(document).ready(function() {
        reload();

        // Live updates. Both models already publish and carry socket read
        // gates: AccessRequest is owner-scoped (a directory admin sees all of
        // them, everyone else only their own), Resource is admin-scoped.
        //
        // This page is one derived render — load() fetches the catalog, the
        // caller's own access, their requests and any pending approvals, then
        // renderAll() draws all four together. Patching a single tile would
        // leave the others describing a different moment, so a change re-runs
        // the whole load.
        //
        // The case that matters: an admin approves your request, and the tile
        // you are looking at is still telling you that you cannot get in.
        let timer = null;
        app.subscribe(/^model:(AccessRequest|Resource):/, function(){
            clearTimeout(timer);
            timer = setTimeout(reload, 400);
        });
    });
</script>

<%- include("bottom") %>
